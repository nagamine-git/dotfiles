{
  "env": {
    "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "{{ if eq .chezmoi.os "darwin" }}/Applications/Google Chrome.app/Contents/MacOS/Google Chrome{{ else }}/opt/google/chrome/google-chrome{{ end }}",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(git rebase * --root*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(cargo publish*)",
      "Bash(sendmail*)",
      "Bash(mailx*)",
      "Bash(mutt*)",
      "Bash(ssmtp*)",
      "Bash(swaks*)",
      "Bash(op item*)",
      "Bash(op read*)",
      "Bash(op signin*)",
      "Bash(op document*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/injection-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-usage --refresh >/dev/null 2>&1"
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/claude-notify stop \"作業が完了しました\" >/dev/null 2>&1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "freee-mcp@freee-mcp-marketplace": true
  },
  "extraKnownMarketplaces": {
    "freee-mcp-marketplace": {
      "source": {
        "source": "github",
        "repo": "freee/freee-mcp"
      }
    }
  },
  "language": "japanese",
  "editorMode": "vim",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "allowCommandExecution": true,
  "autoExecuteCommands": true
}
