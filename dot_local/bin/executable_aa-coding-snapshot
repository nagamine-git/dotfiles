#!/usr/bin/env bash
# aa-coding-snapshot — render the Artificial Analysis Coding Agent leaderboard
# with headless Chrome and post it to Slack. Monthly "coding" check that the
# free AA API does not expose. SLACK_BOT_TOKEN comes from the environment
# (op-agent injects it from ~/.config/agents/tower.env).
set -euo pipefail

URL="https://artificialanalysis.ai/agents/coding-agents"
CHANNEL="${AA_SLACK_CHANNEL:-C0932V0Q1KJ}"   # #notify-management-dashboard
CHROME="${CHROME_BIN:-/opt/google/chrome/google-chrome}"
OUT="$(mktemp --suffix=.png)"
trap 'rm -f "$OUT"' EXIT

"$CHROME" --headless --disable-gpu --no-sandbox --hide-scrollbars \
  --window-size=1400,2600 --virtual-time-budget=15000 \
  --screenshot="$OUT" "$URL" >/dev/null 2>&1

[ -s "$OUT" ] || { echo "aa-coding-snapshot: screenshot failed" >&2; exit 1; }

MONTH="$(date +%Y-%m)"
python3 - "$OUT" "$CHANNEL" "$MONTH" <<'PY'
import os, sys, json, urllib.request, urllib.parse
tok, (f, ch, month) = os.environ["SLACK_BOT_TOKEN"], (sys.argv[1], sys.argv[2], sys.argv[3])
def api(m, p):
    r = urllib.request.Request("https://slack.com/api/"+m,
        data=urllib.parse.urlencode(p).encode(), headers={"Authorization": "Bearer "+tok})
    return json.load(urllib.request.urlopen(r))
size = os.path.getsize(f)
u = api("files.getUploadURLExternal", {"filename": f"aa-coding-{month}.png", "length": size})
assert u.get("ok"), u
urllib.request.urlopen(urllib.request.Request(u["upload_url"], data=open(f,"rb").read(), method="POST")).read()
c = api("files.completeUploadExternal", {
    "files": json.dumps([{"id": u["file_id"], "title": f"AA Coding Agent Index {month}"}]),
    "channel_id": ch,
    "initial_comment": f"🧪 Artificial Analysis — Coding Agent Index 月次スナップショット ({month})\n{ 'https://artificialanalysis.ai/agents/coding-agents' }",
})
assert c.get("ok"), c
print("aa-coding-snapshot: sent", month, "->", ch)
PY
