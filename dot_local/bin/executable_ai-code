#!/usr/bin/env bash
# Native CLI presets; no API proxy, classifier, or implicit model fallback.
set -eu

usage() {
  printf '%s\n' \
    'Usage: ai-code [--dry-run] claude|codex [standard|routine|deep|review] [CLI arguments...]' \
    'Default: standard. Pass -- before a prompt matching a preset name.' \
    'Examples:' \
    '  ai-code claude "Fix the failing test"' \
    '  ai-code claude deep "Investigate the architecture"' \
    '  ai-code codex standard exec "Implement the specified change"' \
    '  ai-code codex review --base main' \
    '  ai-code --dry-run codex routine "Update the docs"' \
    'Native CLI arguments are forwarded as-is. Explicit overrides are your responsibility.'
}

fail() {
  printf 'ai-code: %s\n' "$*" >&2
  exit 2
}

version_at_least() {
  local actual=$1 required=$2
  local a b c x y z
  IFS=. read -r a b c <<< "$actual"
  IFS=. read -r x y z <<< "$required"
  (( a > x || (a == x && b > y) || (a == x && b == y && c >= z) ))
}

dry_run=false
if [ "${1:-}" = --dry-run ]; then
  dry_run=true
  shift
fi
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  claude|codex) client=$1; shift ;;
  *) usage >&2; exit 2 ;;
esac

preset=standard
case "${1:-}" in
  standard|routine|deep|review) preset=$1; shift ;;
esac
if [ "${1:-}" = -- ]; then
  shift
fi

case "$client" in
  claude)
    minimum=2.1.257
    case "$preset" in
      standard) model=opus; effort=high ;;
      routine) model=sonnet; effort=medium ;;
      deep) model=claude-fable-5-1; effort=high ;;
      review) model=opus; effort=xhigh ;;
    esac
    command_args=(claude --model "$model" --effort "$effort")
    if [ "$preset" = review ]; then
      # File inspection only. The lead supplies the diff and test output.
      command_args+=(--agent reviewer --tools 'Read,Grep,Glob' --strict-mcp-config)
    fi
    ;;
  codex)
    minimum=0.155.1
    command_args=(codex --profile "quality-$preset")
    if [ "$preset" = review ]; then
      # CLI flags also override a project's broader filesystem permissions.
      command_args+=(--sandbox read-only --config 'approval_policy="never"'
        --config agents.enabled=false review)
    fi
    ;;
esac
command_args+=("$@")

if "$dry_run"; then
  printf '%q ' "${command_args[@]}"
  printf '\n'
  exit 0
fi

command -v "$client" >/dev/null 2>&1 || fail "$client is not installed"
version_output=$("$client" --version) || fail "cannot check $client version"
if [[ "$version_output" =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
  version=${BASH_REMATCH[1]}
else
  fail "cannot parse $client version"
fi
version_at_least "$version" "$minimum" || fail "$client >= $minimum required (found $version)"

if [ "$client" = codex ]; then
  profile_path="${CODEX_HOME:-$HOME/.codex}/quality-$preset.config.toml"
  [ -f "$profile_path" ] || fail "missing $profile_path; apply the chezmoi Codex profiles first"
fi
if [ "$client" = claude ] && [ "$preset" = review ]; then
  agent_path="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/agents/reviewer.md"
  [ -f "$agent_path" ] || fail "missing $agent_path; apply the chezmoi Claude agents first"
fi

# exec preserves signals and the CLI's exit status; failure never retries a cheaper model.
exec "${command_args[@]}"
