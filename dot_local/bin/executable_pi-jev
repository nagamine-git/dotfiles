#!/usr/bin/env bash
# pi-jev — launch Pi with the jev-gate permission gate.
#
# The jev-gate extension (~/.pi/agent/extensions/jev-gate.ts) loads on every Pi
# run and resolves the TypeSafe key by itself, only for its classifier calls. No
# key is put in Pi's environment, so commands run by Pi's bash tool cannot read
# one with `env`. Keys inherited from the caller are dropped for the same reason.
#
# OpenRouter (an external, pay-per-use model router) stays off unless
# PI_JEV_ALLOW_OPENROUTER=1. Only then is OPENROUTER_API_KEY resolved from the
# Agents vault via op-agent into Pi's environment, where Pi's provider reads it;
# tool commands of that run can read it too. Keys are resolved into the process
# environment (not through `op run`, whose output masking would corrupt Pi's
# TUI). Values are never printed or written to disk.
#
# Robust by design: with no service-account token, no op-agent, or when already
# wrapped, it launches Pi without resolving anything, so `pi-jev` always starts.
set -euo pipefail

REAL_PI="$HOME/.pi/agent/bin/pi"
TOKEN="${OP_AGENT_TOKEN_FILE:-$HOME/.config/op/agents-sa-token}"
OPENROUTER_ENV="$HOME/.config/agents/model-openrouter.env"

# Provider keys inherited from the caller would reach every tool command.
unset TYPESAFE_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY ARTIFICIAL_ANALYSIS_API_KEY
if [ "${PI_JEV_ALLOW_OPENROUTER:-}" != 1 ]; then
  unset OPENROUTER_API_KEY
elif [ -z "${PI_JEV_WRAPPED:-}" ] && [ -r "$TOKEN" ] && [ -r "$OPENROUTER_ENV" ] &&
  command -v op-agent >/dev/null 2>&1; then
  # Only the OPENROUTER_API_KEY line, quoted (spaces allowed inside) or bare, as jev-gate.ts
  # parses its reference; other keys stay out. A read failure still starts Pi.
  ref="$(sed -nE 's/^OPENROUTER_API_KEY=("(op:\/\/[^"]+)"|(op:\/\/[^[:space:]]+))[[:space:]]*$/\2\3/p' \
    "$OPENROUTER_ENV" | head -n 1)" || ref=""
  if [ -n "$ref" ] && val="$(op-agent read "$ref" 2>/dev/null)"; then
    export OPENROUTER_API_KEY="$val"
  fi
fi

# zsh のエイリアスと関数を、Pi の bash ツールと ! コマンドでも使えるように書き出す。Pi は settings.json の
# shellPath (zsh) で `zsh -c "<shellCommandPrefix>\n<command>"` を起動し、その prefix がこのファイルを読む
# (dot_pi/agent/modify_settings.json)。非対話の zsh -c は ~/.zshrc を読まないので、起動のたびに 1 回だけ
# 対話の zsh から取る。PATH などの環境変数は書かない (Pi が起動時の環境を引き継ぐ)。次は書き出さない:
#   - --color=always や --icons を含むエイリアス (ls = eza --icons --color=always など)。出力に ANSI の色コードと
#     アイコンの文字が混ざり、モデルには雑音になる。ls・ll・la は素の ls になる
#   - PATH のコマンドや組み込みと同じ名前のエイリアスと関数 (cc = Claude を起動する関数、ld = lazydocker など)。
#     モデルが書く標準のコマンドが別物にすり替わる
#   - 名前で呼ばずに動く関数 (command_not_found_handler・TRAP*・chpwd など)
# zshrc が標準出力に書くものは捨てる (スナップショットに混ざるとコマンドとして実行される)。zsh が無い・失敗した・
# 5 秒で終わらないときは前のスナップショットのまま (無ければ無しで) Pi を起動する。
PI_ZSH_SNAPSHOT="${XDG_CACHE_HOME:-$HOME/.cache}/pi/zsh-snapshot.zsh"
# zsh に渡すコードなので、$ は bash ではなく zsh が展開する
# shellcheck disable=SC2016
ZSH_DUMP='zmodload zsh/parameter
{
  for n in ${(ko)aliases}; do
    (( $+commands[$n] || $+builtins[$n] )) || [[ $aliases[$n] == *(--color=always|--icons)* ]] || builtin alias -L -- $n
  done
  for n in ${(ko)functions}; do
    (( $+commands[$n] || $+builtins[$n] )) ||
      [[ $n == (command_not_found_handler|TRAP*|precmd|preexec|chpwd|periodic|zshexit|zshaddhistory) ]] ||
      builtin functions -- $n
  done
} >| $1 && exit 0'
if [ -z "${PI_JEV_WRAPPED:-}" ] && command -v zsh >/dev/null 2>&1; then
  (
    umask 077
    mkdir -p "${PI_ZSH_SNAPSHOT%/*}" && tmp="$(mktemp "$PI_ZSH_SNAPSHOT.XXXXXX")" || exit 0
    if timeout 5 zsh -ic "$ZSH_DUMP" zsh "$tmp" </dev/null >/dev/null 2>&1 && [ -s "$tmp" ]; then
      mv -f "$tmp" "$PI_ZSH_SNAPSHOT"
    else
      rm -f "$tmp"
    fi
  ) || true
fi
export PI_ZSH_SNAPSHOT

export PI_JEV_WRAPPED=1
exec "$REAL_PI" "$@"
