#!/usr/bin/env bash
# Web 会議のリングライト。カメラ (/dev/video*) をどれかのプロセスが開いている間だけ、ringa (画面の縁を光らせる
# Wayland の重ね表示、mise の cargo:ringa) を点ける。macOS の Edge Light に近いもの。
#
#   ringa-camera-watch          見張り役 (Hyprland の起動時に 1 つだけ動かす)。2 秒ごとにカメラの使用を調べる
#   ringa-camera-watch toggle   手動で点け消し (Super+F12)。会議の途中でも消せる
#
# 色は RINGA_TEMP (white|warm|golden|studio|daylight|cool|<ケルビン>)。既定は warm。
# 見張り役が点け消しするのは、カメラの使用が「始まった」「終わった」ときだけ。間で手動で消したら、そのまま消えている。
set -u

RINGA="$(command -v ringa 2>/dev/null || true)"
[ -n "$RINGA" ] || RINGA="$HOME/.local/share/mise/installs/cargo-ringa/latest/bin/ringa"
TEMP="${RINGA_TEMP:-warm}"
INTERVAL=2

running() { pgrep -x ringa >/dev/null 2>&1; }
light_on() { running || (setsid "$RINGA" "$TEMP" >/dev/null 2>&1 < /dev/null &); }
light_off() { pkill -x ringa 2>/dev/null || true; }

camera_in_use() {
  local dev
  for dev in /dev/video*; do
    [ -e "$dev" ] || continue
    fuser -s "$dev" 2>/dev/null && return 0
  done
  return 1
}

if [ "${1:-}" = "toggle" ]; then
  if running; then light_off; else light_on; fi
  exit 0
fi

[ -x "$RINGA" ] || { echo "ringa-camera-watch: ringa が無い ($RINGA)。mise install cargo:ringa" >&2; exit 1; }

# 見張り役は 1 つだけ
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ringa-camera-watch.lock"
flock -n 9 || exit 0

prev=0
while true; do
  if camera_in_use; then now=1; else now=0; fi
  if [ "$now" != "$prev" ]; then
    if [ "$now" = 1 ]; then light_on; else light_off; fi
    prev=$now
  fi
  sleep "$INTERVAL"
done
