#!/usr/bin/env bash
# 保存済みの使用枠リセット予定時刻を通知する。実際のリセットは確認しない。
set -eu

ICON="☁"
POLL_INTERVAL=300

notify() {
    notify-send "${ICON} Claude" "$1" --urgency=normal 2>/dev/null \
        || echo "[claude-usage-notify] $1"
}

pending_reset=0
last_notified=0
while true; do
    reset=$("${HOME}/.local/bin/claude-usage-cache" --reset-5h 2>/dev/null || echo 0)
    now=$(date +%s)
    case "$reset" in
        ''|*[!0-9]*) reset=0 ;;
    esac
    if [ "$reset" -gt "$last_notified" ] && [ "$reset" -gt 0 ]; then
        pending_reset=$reset
    fi

    if [ "$pending_reset" -gt 0 ] && [ "$now" -ge "$pending_reset" ]; then
        notify "保存済みの5時間枠のリセット予定時刻です。実際の残枠は Claude Code の /usage で確認してください。"
        last_notified=$pending_reset
        pending_reset=0
    fi

    wait_seconds=$POLL_INTERVAL
    if [ "$pending_reset" -gt "$now" ] && [ $((pending_reset - now)) -lt "$wait_seconds" ]; then
        wait_seconds=$((pending_reset - now))
    fi
    sleep "$wait_seconds"
done
