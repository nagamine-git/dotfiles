#!/usr/bin/env python3
"""Claude Code・Codex・Pi の設定を、共通の置き場 (~/.agents) と Claude の subagent から揃える。

  skills     ~/.agents/skills/<name> を ~/.claude/skills/<name> からのシンボリックリンクにする (Codex と Pi は直接読む)
  subagents  ~/.claude/agents/*.md から Codex 用の ~/.codex/agents/*.toml と Pi 用の ~/.pi/agent/agents/*.md を生成する
  mcp        ~/.agents/mcp.json の MCP サーバーを Claude Code (ユーザースコープ)・Codex・Pi (~/.pi/agent/mcp.json) に足す。
             定義に "clients": ["pi", ...] があれば、その道具にだけ配る
  all        上の 3 つ

Pi の分は ~/.pi/agent が無いホスト (Pi を入れていない) では何もしない。
何度実行しても同じ結果になり (冪等)、消すのは「中身が同一の複製」と「元の md が無くなった Pi 用の生成物」だけ。
秘密の値は足さず表示もしない (Pi の mcp.json に本人が入れた env・headers はそのまま残す)。
chezmoi の run_onchange_after_agents-sync.sh.tmpl から呼ばれる。標準ライブラリだけ・Python 3.9 で動く。
"""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

GENERATED_MARK = "# generated by agents-sync — 編集せず元の ~/.claude/agents/*.md を直す"
SKILL_SKIP_NAMES = {"synced"}  # Claude デスクトップの同期用
SKILL_SKIP_PREFIXES = ("source-command-",)  # Codex の取り込みが作る、Claude のスラッシュコマンドの写し
UNMAPPED_AGENT_KEYS = ("disallowedTools", "tools", "model")
EFFORTS = {"low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "xhigh"}
FRONTMATTER_RE = re.compile(r"\A---\n(.*?)\n---\n?", re.S)
PI_MARK = "---\n" + GENERATED_MARK  # Pi の md は frontmatter の 1 行目に目印を置く (先頭が --- でないと読まれない)
PI_TOOLS = {"Read": "read", "Edit": "edit", "Write": "write", "Bash": "bash", "Grep": "grep", "Glob": "find", "LS": "ls"}
PI_BUILTIN_TOOLS = ("read", "bash", "edit", "write", "grep", "find", "ls")
PI_THINKING = ("off", "minimal", "low", "medium", "high", "xhigh", "max")  # Claude の effort (low〜max) はそのままある
PI_MCP_OWNED = ("type", "command", "args", "url")  # 共有の定義から作るキー。ほか (enabled・exposure・env・oauth など) は残す


def home():
    return Path(os.environ.get("HOME") or str(Path.home()))


def claude_dir():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or str(home() / ".claude"))


def claude_json():
    custom = os.environ.get("CLAUDE_CONFIG_DIR")
    return (Path(custom) if custom else home()) / ".claude.json"


def codex_dir():
    return Path(os.environ.get("CODEX_HOME") or str(home() / ".codex"))


def agents_dir():
    return home() / ".agents"


def pi_dir():
    return Path(os.environ.get("PI_CODING_AGENT_DIR") or str(home() / ".pi/agent"))


# ---- subagents: ~/.claude/agents/*.md -> ~/.codex/agents/*.toml, ~/.pi/agent/agents/*.md ------

def parse_agent_md(text):
    """YAML frontmatter (1 行 1 キーだけ) と本文に分ける。"""
    m = FRONTMATTER_RE.match(text)
    if not m:
        return {}, text
    meta = {}
    for line in m.group(1).split("\n"):
        if not line or line[0] in " \t#":
            continue
        key, sep, value = line.partition(":")
        if not sep:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        meta[key.strip()] = value
    return meta, text[m.end():].lstrip("\n")


def toml_string(value):
    return json.dumps(value, ensure_ascii=False)  # JSON の文字列は TOML の基本文字列としても正しい


def toml_multiline(body):
    body = body.strip("\n")
    if "'''" not in body and not body.endswith("'"):
        return "'''\n" + body + "\n'''"
    escaped = body.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
    if escaped.endswith('"'):
        escaped = escaped[:-1] + '\\"'
    return '"""\n' + escaped + '\n"""'


def render_codex_agent(meta, body, source):
    """Codex の custom agent TOML。モデルは指定せず config.toml の既定に任せ、effort だけ写す。"""
    lines = [GENERATED_MARK, "# source: ~/.claude/agents/%s" % source]
    unmapped = ["%s: %s" % (k, meta[k]) for k in UNMAPPED_AGENT_KEYS if k in meta]
    if unmapped:
        lines.append("# Codex に対応のない項目 (無視される): " + "; ".join(unmapped))
    lines.append("name = %s" % toml_string(meta.get("name") or Path(source).stem))
    lines.append("description = %s" % toml_string(meta.get("description", "")))
    effort = EFFORTS.get(meta.get("effort", ""))
    if effort:
        lines.append('model_reasoning_effort = "%s"' % effort)
    lines.append("developer_instructions = " + toml_multiline(body))
    return "\n".join(lines) + "\n"


def render_pi_agent(meta, body, source):
    """Pi の subagent 例 (examples/extensions/subagent) が読む md と、写せなかった項目の説明を返す。"""
    notes = []
    lines = [PI_MARK, "# source: ~/.claude/agents/%s" % source,
             "name: " + toml_string(meta.get("name") or Path(source).stem),
             "description: " + toml_string(meta.get("description", ""))]  # JSON の文字列は YAML の文字列としても正しい
    model, effort = meta.get("model", ""), meta.get("effort", "")
    if model and model != "inherit":
        model = model if "/" in model else "anthropic/" + model
        if effort in PI_THINKING:
            model += ":" + effort
        elif effort:
            notes.append("effort %s は Pi の thinking に無いので付けない" % effort)
        lines.append("model: " + toml_string(model))
    elif effort:
        notes.append("model が無く呼び出し元のモデルと thinking を引き継ぐので effort %s は写さない" % effort)
    names = lambda key: [t.strip().strip("\"'") for t in meta[key].strip("[]").split(",") if t.strip()]
    tools = None
    if "tools" in meta:
        tools = [PI_TOOLS[t] for t in names("tools") if t in PI_TOOLS]
        dropped = [t for t in names("tools") if t not in PI_TOOLS]
        if dropped:
            notes.append("Pi に対応の無い道具を落とした: " + ", ".join(dropped))
        if not tools:
            notes.append("Pi の道具が残らないので tools を書かない (Pi の既定の道具になる)")
    elif "disallowedTools" in meta:  # Pi は許可リストで縛れるので、読み取り専用などをそのまま守る
        denied = {PI_TOOLS.get(t) for t in names("disallowedTools")}
        tools = [t for t in PI_BUILTIN_TOOLS if t not in denied]
    if tools:
        lines.append("tools: " + toml_string(", ".join(dict.fromkeys(tools))))
    return "\n".join(lines + ["---", "", body.strip("\n")]) + "\n", notes


def sync_generated(src_dir, dest_dir, suffix, render, mark, label, prune, dry_run):
    """src_dir/*.md から dest_dir/<stem><suffix> を作る。目印の無い既存ファイルは 1 度だけ退避する。
    元の md が無い生成物は、prune なら消し、そうでなければ報告だけする。"""
    messages = []
    src_dir, dest_dir = Path(src_dir), Path(dest_dir)
    if not src_dir.is_dir():
        return messages
    wanted = set()
    for md in sorted(src_dir.glob("*.md")):
        meta, body = parse_agent_md(md.read_text(encoding="utf-8"))
        text, notes = render(meta, body, md.name)
        target = dest_dir / (md.stem + suffix)
        wanted.add(target.name)
        current = target.read_text(encoding="utf-8") if target.exists() else None
        if current == text:
            continue
        if current is not None and not current.startswith(mark):
            backup = target.with_name(target.name + ".pre-agents-sync.bak")
            if not backup.exists():
                messages.append("%s: 生成物でない %s を %s に退避" % (label, target.name, backup.name))
                if not dry_run:
                    shutil.copy2(str(target), str(backup))
        messages.append("%s: %s を%s" % (label, target.name, "更新" if current is not None else "作成"))
        messages += ["%s: %s: %s" % (label, target.name, note) for note in notes]
        if not dry_run:
            dest_dir.mkdir(parents=True, exist_ok=True)
            target.write_text(text, encoding="utf-8")
    if dest_dir.is_dir():
        for f in sorted(dest_dir.glob("*" + suffix)):
            if f.name in wanted or not f.read_text(encoding="utf-8").startswith(mark):
                continue
            if not prune:
                messages.append("%s: stale: %s は元の md が無い生成物 (不要なら削除)" % (label, f.name))
                continue
            messages.append("%s: 元の md が無い生成物 %s を削除" % (label, f.name))
            if not dry_run:
                f.unlink()
    return messages


def sync_subagents(src_dir, dest_dir, dry_run=False):
    return sync_generated(src_dir, dest_dir, ".toml", lambda m, b, s: (render_codex_agent(m, b, s), []),
                          GENERATED_MARK, "subagents", False, dry_run)


def sync_pi_subagents(src_dir, dest_dir, dry_run=False):
    return sync_generated(src_dir, dest_dir, ".md", render_pi_agent, PI_MARK, "subagents/pi", True, dry_run)


# ---- skills: ~/.agents/skills/<name> <- ~/.claude/skills/<name> ------------------------------

def trees_equal(a, b):
    def files(root):
        out = {}
        for dirpath, _dirs, names in os.walk(str(root)):
            for name in names:
                p = Path(dirpath) / name
                out[str(p.relative_to(root))] = p
        return out

    fa, fb = files(a), files(b)
    if set(fa) != set(fb):
        return False
    return all(fa[k].is_symlink() == fb[k].is_symlink() and fa[k].read_bytes() == fb[k].read_bytes() for k in fa)


def sync_skills(agents_skills, claude_skills, dry_run=False):
    messages = []
    agents_skills, claude_skills = Path(agents_skills), Path(claude_skills)
    if not agents_skills.is_dir():
        return messages
    for skill in sorted(agents_skills.iterdir()):
        name = skill.name
        if (name.startswith(".") or name in SKILL_SKIP_NAMES or name.startswith(SKILL_SKIP_PREFIXES)
                or not skill.is_dir() or not (skill / "SKILL.md").is_file()):
            continue
        link = claude_skills / name
        if link.is_symlink():
            if link.resolve() != skill.resolve():
                messages.append("skills: %s は別の場所へのリンクのまま (触らない)" % name)
            continue
        if link.exists():
            if link.is_dir() and trees_equal(link, skill):
                messages.append("skills: %s の同一の複製をリンクに置き換え" % name)
                if not dry_run:
                    shutil.rmtree(str(link))
            else:
                messages.append("skills: %s は ~/.claude/skills と ~/.agents/skills で中身が違う (どちらも残した。要確認)" % name)
                continue
        else:
            messages.append("skills: %s のリンクを作成" % name)
        if not dry_run:
            claude_skills.mkdir(parents=True, exist_ok=True)
            link.symlink_to(os.path.relpath(str(skill), str(claude_skills)))
    return messages


# ---- mcp: ~/.agents/mcp.json -> Claude Code (user scope) / Codex / Pi ---------------------------

def norm_shared(entry):
    if entry.get("url"):
        return ("http", entry["url"])
    return ("stdio", entry["command"], tuple(entry.get("args") or []))


def norm_claude(entry):
    kind = entry.get("type") or ("http" if entry.get("url") and not entry.get("command") else "stdio")
    if kind == "stdio":
        return ("stdio", entry.get("command"), tuple(entry.get("args") or []))
    return (kind, entry.get("url"))


def norm_codex(entry):
    transport = entry.get("transport") or {}
    if transport.get("type") == "stdio":
        return ("stdio", transport.get("command"), tuple(transport.get("args") or []))
    return ("http", transport.get("url"))


def codex_has_env(entry):
    transport = entry.get("transport") or {}
    keys = ("env", "env_vars", "bearer_token_env_var", "http_headers", "env_http_headers")
    return any(transport.get(k) for k in keys)


def norm_pi(entry):
    if entry.get("url") and not entry.get("command"):
        return ("http", entry["url"])
    return ("stdio", entry.get("command"), tuple(entry.get("args") or []))


def plan_mcp(shared, current):
    """shared: 名前 -> 定義。current: 名前 -> {"kind": 正規化した定義, "has_env": bool}。"""
    plan = {}
    for name, entry in shared.items():
        secrets = entry.get("secrets") or []
        have = current.get(name)
        if have is None:
            plan[name] = "needs-secret" if secrets else "add"
        elif have["kind"] == norm_shared(entry):
            plan[name] = "ok"
        elif secrets or have["has_env"]:
            plan[name] = "drift"  # 秘密の入った設定は壊さない。報告だけ
        else:
            plan[name] = "fix"
    return plan


def load_shared_mcp():
    path = agents_dir() / "mcp.json"
    if not path.is_file():
        return None
    servers = json.loads(path.read_text(encoding="utf-8")).get("mcpServers", {})
    return {k: v for k, v in servers.items() if not k.startswith("_")}


def for_client(shared, label):
    """定義に "clients" があれば、そこに名前のある道具にだけ配る。"""
    return {n: e for n, e in shared.items() if "clients" not in e or label in e["clients"]}


def run_tool(cmd, messages, label):
    try:
        result = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as exc:
        messages.append("mcp/%s: 失敗 %s (%s)" % (label, " ".join(cmd[:4]), type(exc).__name__))
        return False
    if result.returncode != 0:
        tail = (result.stderr or result.stdout).strip().splitlines()[-1:] or [""]
        messages.append("mcp/%s: 失敗 (%d) %s: %s" % (label, result.returncode, " ".join(cmd[:4]), tail[0][:160]))
        return False
    return True


def claude_current():
    path = claude_json()
    if not path.is_file():
        return {}
    servers = json.loads(path.read_text(encoding="utf-8")).get("mcpServers") or {}
    return {n: {"kind": norm_claude(e), "has_env": bool(e.get("env") or e.get("headers"))} for n, e in servers.items()}


def codex_current(messages):
    try:
        result = subprocess.run(["codex", "mcp", "list", "--json"], stdin=subprocess.DEVNULL,
                                capture_output=True, text=True, timeout=60)
        entries = json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
        messages.append("mcp/codex: 一覧を読めないのでスキップ (%s)" % type(exc).__name__)
        return None
    return {e["name"]: {"kind": norm_codex(e), "has_env": codex_has_env(e)} for e in entries}


def claude_json_for(entry):
    if entry.get("url"):
        return json.dumps({"type": "http", "url": entry["url"]})
    return json.dumps({"type": "stdio", "command": entry["command"], "args": list(entry.get("args") or [])})


def codex_add_cmd(name, entry):
    if entry.get("url"):
        return ["codex", "mcp", "add", name, "--url", entry["url"]]
    return ["codex", "mcp", "add", name, "--", entry["command"]] + list(entry.get("args") or [])


def plan_message(label, shared, name, status):
    if status == "needs-secret":
        return ("mcp/%s: %s は秘密の環境変数 (%s) が要るので自動では足さない。手で追加する"
                % (label, name, ", ".join(shared[name].get("secrets") or [])))
    if status == "drift":
        return "mcp/%s: %s の定義が mcp.json と違う (秘密を含むため触らない。要確認)" % (label, name)
    return "mcp/%s: %s を%s" % (label, name, "入れ替え" if status == "fix" else "追加")


def apply_mcp(label, shared, plan, add_cmd, remove_cmd, dry_run, messages):
    for name, status in plan.items():
        if status == "ok":
            continue
        messages.append(plan_message(label, shared, name, status))
        if status in ("add", "fix"):
            if dry_run:
                continue
            if status == "fix" and not run_tool(remove_cmd(name), messages, label):
                continue
            run_tool(add_cmd(name, shared[name]), messages, label)


def write_atomic(path, text):
    """同じディレクトリの一時ファイルに書いてから置き換える。新しいファイルは 0600、既存は元の権限のまま。"""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if path.exists():
            os.chmod(tmp, path.stat().st_mode & 0o7777)
        os.replace(tmp, str(path))
    except BaseException:
        os.unlink(tmp)
        raise


def sync_pi_mcp(shared, dry_run, messages):
    """~/.pi/agent/mcp.json を直接書く。command/args/url だけを共有の定義に合わせ、ほかのキーと Pi だけの定義は残す。"""
    path = pi_dir() / "mcp.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
        servers = dict(data.get("mcpServers") or {})
    except (ValueError, AttributeError) as exc:
        messages.append("mcp/pi: %s を読めないので触らない (%s)" % (path, type(exc).__name__))
        return
    current = {n: {"kind": norm_pi(e), "has_env": bool(e.get("env") or e.get("headers"))} for n, e in servers.items()}
    updated = dict(servers)
    for name, status in plan_mcp(shared, current).items():
        if status == "ok":
            continue
        messages.append(plan_message("pi", shared, name, status))
        if status in ("add", "fix"):
            entry = shared[name]
            transport = {"url": entry["url"]} if entry.get("url") else \
                {"command": entry["command"], "args": list(entry.get("args") or [])}
            kept = {k: v for k, v in servers.get(name, {}).items() if k not in PI_MCP_OWNED}
            updated[name] = dict(transport, **kept)
    for name in sorted(set(servers) - set(shared)):
        messages.append("mcp/pi: %s は Pi だけにある (残した)" % name)
    if updated != servers and not dry_run:
        write_atomic(path, json.dumps(dict(data, mcpServers=updated), indent=2, ensure_ascii=False) + "\n")


def sync_mcp(dry_run=False):
    messages = []
    shared = load_shared_mcp()
    if shared is None:
        return ["mcp: ~/.agents/mcp.json が無いのでスキップ"]
    if shutil.which("claude"):
        plan = plan_mcp(for_client(shared, "claude"), claude_current())
        apply_mcp("claude", shared, plan,
                  lambda n, e: ["claude", "mcp", "add-json", "-s", "user", n, claude_json_for(e)],
                  lambda n: ["claude", "mcp", "remove", "-s", "user", n], dry_run, messages)
    else:
        messages.append("mcp: claude が見つからないので Claude Code 側をスキップ")
    if shutil.which("codex"):
        current = codex_current(messages)
        if current is not None:
            plan = plan_mcp(for_client(shared, "codex"), current)
            apply_mcp("codex", shared, plan, codex_add_cmd,
                      lambda n: ["codex", "mcp", "remove", n], dry_run, messages)
    else:
        messages.append("mcp: codex が見つからないので Codex 側をスキップ")
    if pi_dir().is_dir():
        sync_pi_mcp(for_client(shared, "pi"), dry_run, messages)
    else:
        messages.append("mcp: ~/.pi/agent が無いので Pi 側をスキップ")
    return messages


# ---- entry point ------------------------------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(description="Claude Code・Codex・Pi の共有設定を揃える")
    parser.add_argument("what", choices=["skills", "subagents", "mcp", "all"])
    parser.add_argument("--dry-run", action="store_true", help="変更せず、何をするかだけ表示する")
    args = parser.parse_args(argv)
    messages = []
    if args.what in ("skills", "all"):
        messages += sync_skills(agents_dir() / "skills", claude_dir() / "skills", args.dry_run)
    if args.what in ("subagents", "all"):
        messages += sync_subagents(claude_dir() / "agents", codex_dir() / "agents", args.dry_run)
        if pi_dir().is_dir():
            messages += sync_pi_subagents(claude_dir() / "agents", pi_dir() / "agents", args.dry_run)
    if args.what in ("mcp", "all"):
        messages += sync_mcp(args.dry_run)
    prefix = "[dry-run] " if args.dry_run else ""
    for line in messages:
        print(prefix + line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
