#!/bin/bash
# Claude Code のフック (Stop / Notification) と、他のスクリプトから呼ばれる通知スクリプト。
#   claude-notify stop [summary] [body]
#   claude-notify notification [summary] [body]
#   claude-notify <その他の種類> [summary] [body]   (例: security-update-check.sh の security-update)
# フックの stdin JSON (message / title / cwd / transcript_path) を読み、
# デスクトップ通知 (notify-send / osascript) に加えて ntfy でスマホへ送る。
# herdr の中の stop / notification は、エージェントの完了と承認待ちとして herdr が通知する ([ui.toast])。
# ここではデスクトップに出さず、スマホへの送信と Super+Shift+R (claude-notify-focus --last) の移動先の記録だけをする。
# スマホへ送る条件は ~/.config/claude-notify/config の PHONE_MODE で決める。
set -euo pipefail

mode="${1:-stop}"
summary_arg="${2:-}"
body_arg="${3:-}"

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/claude-code-notify"
mkdir -p "$runtime_dir"

# ---- フックの stdin JSON --------------------------------------------------
hook_message=""
hook_title=""
hook_cwd=""
transcript=""
if [ ! -t 0 ] && command -v jq >/dev/null 2>&1; then
  hook_json="$(cat 2>/dev/null || true)"
  if [ -n "$hook_json" ]; then
    hook_message="$(printf '%s' "$hook_json" | jq -r '.message // empty' 2>/dev/null || true)"
    hook_title="$(printf '%s' "$hook_json" | jq -r '.title // empty' 2>/dev/null || true)"
    hook_cwd="$(printf '%s' "$hook_json" | jq -r '.cwd // empty' 2>/dev/null || true)"
    transcript="$(printf '%s' "$hook_json" | jq -r '.transcript_path // empty' 2>/dev/null || true)"
  fi
fi

# Stop 時は transcript の最後のアシスタント発言を要約代わりに使う
last_assistant_text() {
  [ -n "$transcript" ] && [ -r "$transcript" ] || return 0
  tail -n 200 "$transcript" 2>/dev/null \
    | jq -r 'select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text' 2>/dev/null \
    | grep -v '^\s*$' | tail -n 1 | tr -s '[:space:]' ' ' | cut -c1-160 || true
}

cwd="${hook_cwd:-${PWD:-}}"

# ---- herdr の位置 ---------------------------------------------------------
# 取れなければ移動先を記録せず、スマホのタイトルに space 名を使わないだけで、通知は止めない
in_herdr=0; herdr_workspace=""; herdr_tab=""; herdr_pane=""; space_name=""
[ "${HERDR_ENV:-}" = "1" ] && in_herdr=1
if [ "$in_herdr" = 1 ] && command -v jq >/dev/null 2>&1; then
  herdr_bin="${HERDR_BIN_PATH:-herdr}"
  # ペインを別の space へ移すと環境変数の ID は古くなるので、今の所属を herdr に聞く
  pane_json="$("$herdr_bin" pane current --current 2>/dev/null || true)"
  herdr_workspace="$(printf '%s' "$pane_json" | jq -r '.result.pane.workspace_id // empty' 2>/dev/null || true)"
  herdr_tab="$(printf '%s' "$pane_json" | jq -r '.result.pane.tab_id // empty' 2>/dev/null || true)"
  herdr_pane="$(printf '%s' "$pane_json" | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)"
  if [ -n "$herdr_workspace" ]; then
    space_json="$("$herdr_bin" workspace get "$herdr_workspace" 2>/dev/null || true)"
    # 名前は ntfy のタイトル (HTTP ヘッダー) と記録の 1 行に使うので制御文字を除く
    space_name="$(printf '%s' "$space_json" | jq -r '.result.workspace.label // empty | gsub("[[:cntrl:]]"; "")' 2>/dev/null || true)"
  fi
fi

# ---- 本文 -------------------------------------------------------------------
# agent_event: herdr がエージェントの状態から通知できるもの (完了と承認待ち)
agent_event=0
summary="Claude Code"
body=""
case "$mode" in
  stop)
    agent_event=1
    summary="Claude Code: 完了"
    body="${summary_arg:-$(last_assistant_text)}"
    body="${body:-作業が完了しました}"
    ;;
  notification)
    agent_event=1
    summary="Claude Code: ${hook_title:-入力待ち}"
    body="${summary_arg:-${hook_message:-確認や許可を待っています}}"
    ;;
  *)
    summary="Claude Code"
    body="${summary_arg:-${hook_message:-通知}}"
    ;;
esac
[ -n "$body_arg" ] && body="$body_arg"

project="$(basename "${cwd:-/}")"
full_body="$body"
[ -n "$cwd" ] && full_body="$body\ncwd: $cwd"

# Super+Shift+R (claude-notify-focus --last) で移る先。1 行に 1 つ、workspace / tab / pane / space 名の順
if [ "$agent_event" = 1 ] && [ -n "$herdr_workspace" ]; then
  printf '%s\n' "$herdr_workspace" "$herdr_tab" "$herdr_pane" "$space_name" > "$runtime_dir/last_herdr"
fi

# ---- スマホ (ntfy) ----------------------------------------------------------
NTFY_SERVER="https://ntfy.sh"; NTFY_TOPIC=""; PHONE_MODE="locked"
config="${XDG_CONFIG_HOME:-$HOME/.config}/claude-notify/config"
# shellcheck disable=SC1090
[ -r "$config" ] && . "$config"
PHONE_MODE="${CLAUDE_NOTIFY_PHONE:-$PHONE_MODE}"

screen_locked() {
  if command -v pgrep >/dev/null 2>&1 && pgrep -x hyprlock >/dev/null 2>&1; then return 0; fi
  if [ "$(uname -s)" = "Darwin" ] && ioreg -n Root -d1 -a 2>/dev/null | grep -q CGSSessionScreenIsLocked; then return 0; fi
  return 1
}

push_phone() {
  [ -n "$NTFY_TOPIC" ] || return 0
  case "$PHONE_MODE" in
    never) return 0 ;;
    locked) screen_locked || return 0 ;;
    always) ;;
    *) return 0 ;;
  esac
  local prio="default" tags="white_check_mark"
  case "$mode" in
    notification) prio="high"; tags="raising_hand" ;;
  esac
  # 本文は外部由来 (返答本文など)。-d だと先頭 @ でローカルファイルを送るため stdin から渡す
  printf '%s' "$body" | curl -fsS -m 8 \
    -H "Title: ${summary} [${space_name:-$project} @ $(hostname -s)]" \
    -H "Priority: ${prio}" -H "Tags: ${tags}" \
    --data-binary @- \
    "${NTFY_SERVER%/}/${NTFY_TOPIC}" >/dev/null 2>&1 || true
}
push_phone &

# ---- デスクトップ ----------------------------------------------------------
if [ "$in_herdr" = 1 ] && [ "$agent_event" = 1 ]; then
  : # herdr が通知する。二重に出さない
elif command -v notify-send >/dev/null 2>&1; then
  notify-send --app-name="Claude Code" --icon=dialog-information --expire-time=15000 "$summary" "$full_body" >/dev/null 2>&1 || true
elif command -v osascript >/dev/null 2>&1; then
  # macOS: osascript で表示 (argv 渡しでクオート問題を回避)
  osascript -e 'on run argv' \
            -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
            -e 'end run' "$summary" "$(printf '%b' "$full_body")" >/dev/null 2>&1 || true
fi
wait
