#!/usr/bin/env python3
"""OpenAI-first entry point. Unverifiable paid provider paths fail closed."""
import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import select
import signal
import stat
import subprocess
import sys
import tempfile
import time
import tomllib

HERE = Path(__file__).resolve().parent
PLANNER = HERE / ("executable_model-route-plan" if Path(__file__).name.startswith(("executable_", "private_executable_")) else "model-route-plan")
LOADER = importlib.machinery.SourceFileLoader("model_route_planner", str(PLANNER))
P = importlib.util.module_from_spec(importlib.util.spec_from_loader(LOADER.name, LOADER))
LOADER.exec_module(P)
VERSION = "codex-cli 0.166.0"
CONFIG_KEYS = {"version", "monthly_api_limit_cents", "per_request_target_cents", "request_timeout_seconds"}
# Explicit future invocations only. A workflow keeps or lowers its own effort;
# nothing raises a selection, restores an earlier one, or touches running threads.
WORKFLOWS = {
    "review": ("gpt-6.1-sol", "xhigh"),
    "code-efficient": ("gpt-6.1-terra", "xhigh"),
    "routine": ("gpt-6.1-terra", "low"),
    "deep-review": ("gpt-6.1-sol", "max"),
}
DEEP_REVIEW_DOWNSHIFT = "xhigh"
DOWNSHIFT_ABOVE_PERCENT = 50
GENERAL_BUCKET = "codex"
EFFECTIVE_PINS = {"model_provider": "openai", "forced_login_method": "chatgpt"}
APP_SERVER_SECONDS = 20
APP_SERVER_MAX_LINE = 1024 * 1024
APP_SERVER_MAX_BYTES = 4 * 1024 * 1024
MODEL_LIST_MAX_PAGES = 10
CLIENT_INFO = {"name": "model_route", "title": "model-route read-only check", "version": "1"}
BLOCKERS = {
    "typesafe": "No documented provider budget/auto-refill read API; billing controls unverified",
    "anthropic": "Provider spend-cap/account binding and auto-refill remain unverified",
}
ROUTING_KEYS = {"model_provider", "model_providers", "openai_base_url", "chatgpt_base_url",
                "forced_login_method", "cli_auth_credentials_store"}


def emit(data):
    print(json.dumps(data, ensure_ascii=False, sort_keys=True), flush=True)


def runtime_config():
    config = P.read_json(Path.home() / ".config/model-routing/policy.json")
    if (not isinstance(config, dict) or set(config) != CONFIG_KEYS
            or type(config["version"]) is not int or config["version"] != 1
            or not P.integer(config["monthly_api_limit_cents"], 0, 2000)
            or not P.integer(config["per_request_target_cents"], 0, 500)
            or not P.integer(config["request_timeout_seconds"], 1, 300)):
        raise P.Blocked("Invalid or expanded runtime budget policy")
    return config


def no_auth_overrides():
    prefixes = ("ANTHROPIC_", "TYPESAFE_", "OPENAI_", "CODEX_API_", "CLAUDE_CODE_USE_")
    names = {"OP_SERVICE_ACCOUNT_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CONFIG_DIR", "CODEX_HOME", "CODEX_CONFIG_FILE"}
    if any(value and (key.startswith(prefixes) or key in names) for key, value in os.environ.items()):
        raise P.Blocked("Provider/auth override present; subscription path is not verified")


def read_codex_config(path):
    # Only non-secret config.toml; never auth.json, credentials, or sessions.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size > P.MAX_BYTES:
                raise P.Blocked("Codex configuration must be a bounded regular file")
            raw = source.read(P.MAX_BYTES + 1)
        if len(raw) > P.MAX_BYTES:
            raise P.Blocked("Codex configuration exceeds the size limit")
        return tomllib.loads(raw.decode())
    except (OSError, ValueError, UnicodeError):
        raise P.Blocked("Codex configuration unavailable") from None


def has_routing_override(value):
    if isinstance(value, dict):
        return bool(ROUTING_KEYS.intersection(value)) or any(has_routing_override(v) for v in value.values())
    if isinstance(value, list):
        return any(has_routing_override(v) for v in value)
    return False


def reject_project_routing(cwd):
    # Check config metadata along the cwd ancestor chain, without collecting repo
    # contents or accepting a new trust setting. CLI pins model/effort separately.
    cwd, home = cwd.resolve(), Path.home().resolve()
    for directory in (cwd, *cwd.parents):
        if directory == home:
            continue  # Home defaults and profiles are checked by codex_config().
        config_dir = directory / ".codex"
        if config_dir.is_symlink():
            raise P.Blocked("Symlinked project configuration cannot verify the subscription endpoint")
        path = config_dir / "config.toml"
        if path.exists() or path.is_symlink():
            if has_routing_override(read_codex_config(path)):
                raise P.Blocked("Project provider/auth overrides are outside this subscription entry point")


def codex_config():
    config = read_codex_config(Path.home() / ".codex/config.toml")
    if (config.get("model_provider", "openai") != "openai"
            or config.get("openai_base_url") or config.get("chatgpt_base_url")
            or config.get("model_providers", {}).get("openai")
            or has_routing_override(config.get("profiles", {}))):
        raise P.Blocked("Custom inference endpoint is outside this subscription entry point")
    model, effort = config.get("model"), config.get("model_reasoning_effort")
    if not isinstance(model, str) or re.fullmatch(r"gpt-[a-z0-9.-]+", model) is None:
        raise P.Blocked("OpenAI default model must remain explicit")
    if effort not in ("low", "medium", "high", "xhigh", "max"):
        raise P.Blocked("Codex reasoning configuration is unrecognized")
    return config


def codex_auth():
    no_auth_overrides()
    binary = Path.home() / ".local/bin/codex"
    try:
        version = subprocess.run([str(binary), "--version"], capture_output=True, text=True, timeout=10)
        auth = subprocess.run([str(binary), "login", "status"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        raise P.Blocked("Codex version/auth metadata unavailable") from None
    if version.returncode or version.stdout.strip() != VERSION:
        raise P.Blocked("Unreviewed Codex version; no model started")
    text = (auth.stdout + auth.stderr).lower()
    if auth.returncode or "logged in" not in text or "chatgpt" not in text or "api key" in text:
        raise P.Blocked("ChatGPT subscription authentication is not verified")
    config = codex_config()
    return binary, config


def planner_policy(config):
    return {"version": 1, "execution_enabled": False, "claude_auth_mode": "anthropic_api",
            "timeout_ms": 1000, "per_call_limit_cents": config["per_request_target_cents"],
            "daily_limit_cents": config["monthly_api_limit_cents"],
            "monthly_limit_cents": config["monthly_api_limit_cents"]}


def sanitize_text(text):
    if not isinstance(text, str) or not text.strip() or len(text.encode()) > 65536:
        raise P.Blocked("Context must be nonempty bounded reviewed text")
    # Refuse recognizable credentials instead of relying on lossy output masking.
    forbidden = [r"-----BEGIN (?:[A-Z ]*PRIVATE KEY|PGP)", r"\bsk-[A-Za-z0-9_-]{10,}",
                 r"\b(?:Bearer|Basic)\s+[A-Za-z0-9+/_.=-]{8,}", r"op://",
                 r"(?i)(?:api[_-]?key|password|credential|secret|token)\s*[\"']?\s*[:=]\s*[\"']?[^\s\"']{8,}",
                 r"\b(?:ghp_|github_pat_|xox[baprs]-|AKIA)[A-Za-z0-9_-]{10,}"]
    if any(re.search(pattern, text) for pattern in forbidden):
        raise P.Blocked("Credential-like content rejected before any model call")
    text = re.sub(r"[\w.!#$%&'*+/=?^`{|}~-]+@[\w.-]+\.[A-Za-z]{2,}", "[REDACTED_EMAIL]", text)
    text = re.sub(r"(?<!\w)(?:\+?\d[ ()-]?){9,14}\d(?!\w)", "[REDACTED_PHONE]", text)
    text = re.sub(r"/(?:home|Users)/[^/\s]+", "/[REDACTED_USER_HOME]", text)
    return text


def context_file(path):
    envelope = P.read_json(path, 100000)
    if (not isinstance(envelope, dict) or set(envelope) != {"text", "reviewed_no_secrets_or_pii", "scope"}
            or envelope["reviewed_no_secrets_or_pii"] is not True
            or envelope["scope"] not in ("public", "efg_private_sanitized")):
        raise P.Blocked("Only explicitly reviewed public or sanitized EFG context is accepted")
    # Automatic patterns supplement, rather than replace, the context review.
    return sanitize_text(envelope["text"])


def load_attempts(directory):
    path = directory / "executions.json"
    if not path.exists() and not path.is_symlink():
        return {}
    data = P.read_json(path, P.MAX_BYTES)
    if not isinstance(data, dict):
        raise P.Blocked("Invalid execution ledger; no reset attempted")
    for key, value in data.items():
        if (not isinstance(value, dict) or set(value) != {"fingerprint", "state"}
                or not isinstance(value["fingerprint"], str)
                or re.fullmatch(r"[0-9a-f]{64}", value["fingerprint"]) is None
                or value["state"] not in ("reserved", "completed", "failed", "uncertain")):
            raise P.Blocked("Invalid execution reservation")
    return data


def atomic_attempts(directory, data):
    raw = json.dumps(data, sort_keys=True)
    if len(raw.encode()) > P.MAX_BYTES:
        raise P.Blocked("Execution ledger is full; no reservations discarded")
    fd, name = tempfile.mkstemp(prefix=".execution-", dir=directory)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(raw)
            out.flush()
            os.fsync(out.fileno())
        os.replace(name, directory / "executions.json")
    finally:
        if os.path.exists(name):
            os.unlink(name)


def reserve(directory, task_id, fingerprint):
    with P.state_lock(directory) as state:
        data = load_attempts(state)
        if task_id in data:
            if data[task_id]["fingerprint"] != fingerprint:
                raise P.Blocked("Request ID already belongs to different task/context; no replay")
            raise P.Blocked("Request was already attempted; uncertain outcomes are never replayed")
        data[task_id] = {"fingerprint": fingerprint, "state": "reserved"}
        atomic_attempts(state, data)


def finish(directory, task_id, state):
    with P.state_lock(directory) as root:
        data = load_attempts(root)
        if task_id not in data or data[task_id]["state"] != "reserved":
            raise P.Blocked("Execution state changed; outcome is uncertain and must not be replayed")
        data[task_id]["state"] = state
        atomic_attempts(root, data)


def base_command(binary, config):
    # Pin to the already-configured home defaults for this invocation, so a
    # project cannot silently select another model/provider after the auth check.
    return [str(binary), "--no-daemon", "-c", 'forced_login_method="chatgpt"',
            "-c", 'model_provider="openai"', "-c", 'model=' + json.dumps(config["model"]),
            "-c", 'model_reasoning_effort=' + json.dumps(config["model_reasoning_effort"])]


def disabled_skill_paths():
    paths = set()
    for root in (Path.home() / ".agents/skills", Path.home() / ".codex/skills", Path("/etc/codex/skills")):
        if not root.is_dir():
            continue
        for file in root.rglob("SKILL.md"):
            paths.add(str(file.parent.resolve()))
        # pathlib rglob does not descend into symlinked skill folders.
        for child in root.iterdir():
            if child.is_symlink() and (child / "SKILL.md").is_file():
                paths.add(str(child.resolve()))
    return [{"path": path, "enabled": False} for path in sorted(paths)]


def text_command(binary, config):
    disabled = ", ".join('{ path = ' + json.dumps(row["path"]) + ', enabled = false }'
                         for row in disabled_skill_paths())
    command = base_command(binary, config) + [
               "-c", 'web_search="disabled"', "-c", "features.shell_tool=false",
               "-c", "features.apps=false", "-c", "features.multi_agent=false",
               "-c", "features.hooks=false", "-c", "features.browser_use=false",
               "-c", "features.memories=false",
               "-c", "memories.use_memories=false", "-c", "memories.generate_memories=false",
               "-c", "project_doc_max_bytes=0", "-c", "skills.config=[" + disabled + "]"]
    for name in config.get("mcp_servers", {}):
        if re.fullmatch(r"[A-Za-z0-9_@-]+", name) is None:
            raise P.Blocked("MCP identifier cannot be safely disabled for this CLI version")
        command += ["-c", 'mcp_servers.' + name + '.enabled=false']
    for name in config.get("plugins", {}):
        if re.fullmatch(r"[A-Za-z0-9_@-]+", name) is None:
            raise P.Blocked("Plugin identifier cannot be safely disabled for this CLI version")
        command += ["-c", 'plugins.' + name + '.enabled=false']
    return command + ["exec", "--ephemeral", "--skip-git-repo-check", "--sandbox", "read-only", "--json", "-"]


def invoke_text(binary, config, text, seconds):
    prompt = "Answer only from the following reviewed text. Do not use tools or read files.\n\n" + text
    with tempfile.TemporaryDirectory(prefix="model-route-text-") as cwd:
        proc = subprocess.Popen(text_command(binary, config), cwd=cwd, stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
        try:
            out, err = proc.communicate(prompt, timeout=seconds)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.communicate()
            return {"state": "uncertain", "exit_code": proc.returncode, "response": None, "reason": "timeout_no_replay"}
    # Raw stderr, event logs, thread IDs and working paths are never returned or saved.
    try:
        events = [json.loads(line) for line in out.splitlines() if line.strip()]
    except ValueError:
        return {"state": "uncertain", "exit_code": proc.returncode, "response": None, "reason": "unrecognized_result_no_replay"}
    messages, tools, completed, failed = [], False, False, False
    for event in events:
        if not isinstance(event, dict):
            continue
        item = event.get("item", {})
        if isinstance(item, dict) and event.get("type") in ("item.started", "item.completed"):
            if item.get("type") == "agent_message" and event["type"] == "item.completed":
                messages.append(item.get("text", ""))
            elif item.get("type") not in ("agent_message", "reasoning"):
                tools = True
        completed |= event.get("type") == "turn.completed"
        failed |= event.get("type") in ("turn.failed", "error")
    if proc.returncode or failed or tools or not completed or not messages:
        return {"state": "failed", "exit_code": proc.returncode, "response": None, "reason": "model_or_tool_result_rejected"}
    try:
        response = sanitize_text("\n".join(messages))
    except P.Blocked:
        return {"state": "failed", "exit_code": proc.returncode, "response": None, "reason": "response_content_rejected"}
    return {"state": "completed", "exit_code": proc.returncode, "response": response, "reason": "subscription_response"}


def ask(config, task, context, directory):
    text = context_file(context)
    policy = planner_policy(config)
    # This reserves the metadata proposal but never reserves actual API money.
    plan = P.prepare(policy, task, directory)
    if plan["candidate_route"] == "stop":
        raise P.Blocked("Task authorization/safety state forbids execution and fallback")
    binary, native = codex_auth()
    fingerprint = hashlib.sha256(json.dumps([task, config, text], sort_keys=True).encode()).hexdigest()
    reserve(directory, task["task_id"], fingerprint)
    try:
        result = invoke_text(binary, native, text, config["request_timeout_seconds"])
    except Exception:
        finish(directory, task["task_id"], "uncertain")
        raise P.Blocked("Model outcome uncertain; no retry attempted") from None
    finish(directory, task["task_id"], result["state"])
    return {**result, "requested_route": plan["candidate_route"], "executed_route": "codex_subscription",
            "fallback_reason": "provider_budget_unverified" if plan["candidate_route"] in ("opus", "fable") else None,
            "configured_model": native["model"], "configured_effort": native["model_reasoning_effort"],
            "reported_model": None, "paid_api_calls": 0, "api_key_auth_used": False}


def doctor(providers=False):
    binary, config = codex_auth()
    result = {"codex_auth": "chatgpt", "codex_version": VERSION,
              "configured_model": config["model"], "configured_effort": config["model_reasoning_effort"],
              "paid_api_paths_ready": False, "api_blockers": BLOCKERS, "paid_api_calls": 0}
    if providers:
        reports = []
        probe = Path.home() / ".local/lib/model-routing/provider_probe.py"
        for provider in ("typesafe", "anthropic"):
            ref = Path.home() / (".config/agents/model-" + provider + ".env")
            try:
                r = subprocess.run([str(Path.home() / ".local/bin/op-agent"), "run", "--env-file", str(ref),
                                    "--", sys.executable, "-I", "-B", str(probe), provider],
                                   capture_output=True, text=True, timeout=35)
                rows = [clean_provider_report(json.loads(line), provider) for line in r.stdout.splitlines() if line.strip()]
                if r.returncode or not all(isinstance(row, dict) and row.get("provider") == provider for row in rows):
                    raise ValueError
                reports.extend(rows)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                reports.append({"provider": provider, "status": "read_failed", "paid_requests": 0})
        result["provider_reads"] = reports
    return result


def clean_provider_report(row, provider):
    """Never relay arbitrary child-process JSON or remote text to logs."""
    if not isinstance(row, dict) or row.get("provider") != provider or row.get("paid_requests") != 0:
        raise ValueError("Unexpected diagnostic record")
    safe = {"provider": provider, "paid_requests": 0}
    operation = row.get("operation")
    if operation in ("GET /v1/models", "GET /v1/organizations/spend_limits"):
        safe["operation"] = operation
    if type(row.get("http_status")) is int and 100 <= row["http_status"] <= 599:
        safe["http_status"] = row["http_status"]
    if row.get("status") in ("read_failed", "missing_key", "oversized_response"):
        safe["status"] = row["status"]
    for key in ("provider_cap_verified", "auto_refill_verified_off", "billing_api_documented"):
        if row.get(key) is False:
            safe[key] = False
    for key in ("error_body_suppressed", "pagination_incomplete"):
        if type(row.get(key)) is bool:
            safe[key] = row[key]
    if type(row.get("limit_rows_seen")) is int and 0 <= row["limit_rows_seen"] <= 100000:
        safe["limit_rows_seen"] = row["limit_rows_seen"]
    if isinstance(row.get("model_ids"), list):
        safe["model_ids"] = [name for name in row["model_ids"] if isinstance(name, str)
                             and re.fullmatch(r"jev-[a-z0-9.-]{1,64}", name)]
    if isinstance(row.get("available"), dict):
        safe["available"] = {name: row["available"][name] for name in (
            "claude-opus-5-5", "claude-fable-5-1", "claude-sonnet-5-5")
                             if type(row["available"].get(name)) is bool}
    return safe


class Unavailable(Exception):
    """The app-server session ended or misbehaved; upstream details are dropped."""


def app_server_command(binary, config, model, effort):
    # The same endpoint/auth pins as the native entry point, plus workflow pins.
    pinned = {**config, "model": model, "model_reasoning_effort": effort}
    return base_command(binary, pinned) + ["app-server", "--listen", "stdio://"]


class AppServer:
    """Newline-delimited JSON-RPC to one short-lived stdio app-server child."""

    def __init__(self, proc):
        self.proc, self.buffer, self.total, self.last_id = proc, b"", 0, 0
        self.deadline = time.monotonic() + APP_SERVER_SECONDS

    def send(self, message):
        try:
            self.proc.stdin.write(json.dumps(message).encode() + b"\n")
            self.proc.stdin.flush()
        except (OSError, ValueError):
            raise Unavailable from None

    def call(self, method, params=None):
        self.last_id += 1
        message = {"method": method, "id": self.last_id}
        if params is not None:
            message["params"] = params
        self.send(message)
        while True:
            reply = self.receive()
            # Notifications and server-initiated requests are ignored, never relayed.
            if isinstance(reply, dict) and type(reply.get("id")) is int \
                    and reply["id"] == self.last_id and "method" not in reply:
                return None if "error" in reply else reply.get("result")

    def receive(self):
        fd = self.proc.stdout.fileno()
        while True:
            while b"\n" not in self.buffer:
                remaining = self.deadline - time.monotonic()
                if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
                    raise Unavailable
                chunk = os.read(fd, 65536)
                self.total += len(chunk)
                self.buffer += chunk
                if not chunk or self.total > APP_SERVER_MAX_BYTES or len(self.buffer) > APP_SERVER_MAX_LINE:
                    raise Unavailable
            line, self.buffer = self.buffer.split(b"\n", 1)
            try:
                return json.loads(line)
            except (ValueError, UnicodeError):
                continue  # Not a protocol message; its content is never kept.

    def close(self):
        # Only this child's own process group; a shared daemon is never contacted.
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        for sig in (None, signal.SIGTERM, signal.SIGKILL):
            if sig is not None:
                try:
                    os.killpg(self.proc.pid, sig)
                except OSError:
                    pass
            try:
                self.proc.wait(timeout=1 if sig is None else 2)
                break
            except subprocess.TimeoutExpired:
                continue
        self.proc.stdout.close()


def read_models(rpc):
    entries, cursor = [], None
    for _ in range(MODEL_LIST_MAX_PAGES):
        params = {"limit": 100, "includeHidden": False}
        if cursor is not None:
            params["cursor"] = cursor
        page = rpc.call("model/list", params)
        if not isinstance(page, dict) or not isinstance(page.get("data"), list):
            return None
        entries.extend(page["data"])
        cursor = page.get("nextCursor")
        if cursor is None:
            return {"data": entries, "complete": True}
        if not isinstance(cursor, str) or not cursor:
            break
    return {"data": entries, "complete": False}


READS = {
    # Never opts into automatic reserve fallback; reset-credit details are not needed.
    "rate_limits": lambda rpc: rpc.call("account/rateLimits/read",
                                        {"supportsLunaReserve": False, "excludeResetCreditDetails": True}),
    "models": read_models,
    "config": lambda rpc: rpc.call("config/read", {"includeLayers": False, "cwd": str(Path.cwd())}),
}


def app_server_read(binary, config, model, effort, reads):
    """Read-only methods only: no thread, turn, login or config write is requested."""
    results = dict.fromkeys(reads)
    try:
        proc = subprocess.Popen(app_server_command(binary, config, model, effort),
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return results
    rpc = AppServer(proc)
    try:
        if not isinstance(rpc.call("initialize", {"clientInfo": CLIENT_INFO}), dict):
            return results
        rpc.send({"method": "initialized", "params": {}})
        for name in reads:
            results[name] = READS[name](rpc)
    except (Unavailable, OSError):
        pass
    finally:
        rpc.close()
    return results


def quota_window(value):
    if value is None:
        return None
    if (not isinstance(value, dict) or type(value.get("usedPercent")) is not int
            or not 0 <= value["usedPercent"] <= 100
            or any(value.get(key) is not None and (type(value[key]) is not int or value[key] < 0)
                   for key in ("windowDurationMins", "resetsAt"))):
        raise ValueError
    used = value["usedPercent"]
    # usedPercent is the used share; remaining is derived and labelled separately.
    return {"used_percent": used, "remaining_percent": 100 - used,
            "window_duration_mins": value.get("windowDurationMins"), "resets_at": value.get("resetsAt")}


def general_quota(response):
    """Only the general `codex` bucket. Window meaning comes from its duration only."""
    unknown = {"state": "unknown", "bucket": GENERAL_BUCKET, "primary": None, "secondary": None}
    if not isinstance(response, dict):
        return unknown
    by_id = response.get("rateLimitsByLimitId")
    if isinstance(by_id, dict):
        snapshot = by_id.get(GENERAL_BUCKET)
        if isinstance(snapshot, dict) and snapshot.get("limitId") not in (None, GENERAL_BUCKET):
            return unknown
    elif by_id is None:
        snapshot = response.get("rateLimits")
        if not isinstance(snapshot, dict) or snapshot.get("limitId") != GENERAL_BUCKET:
            return unknown
    else:
        return unknown
    if not isinstance(snapshot, dict):
        return unknown
    try:
        windows = {name: quota_window(snapshot.get(name)) for name in ("primary", "secondary")}
    except ValueError:
        return unknown
    if not any(windows.values()):
        return unknown
    return {"state": "known", "bucket": GENERAL_BUCKET, **windows}


def select_effort(workflow, quota):
    model, requested = WORKFLOWS[workflow]
    if workflow != "deep-review":
        return model, requested, requested, None
    if quota["state"] != "known":
        raise P.Blocked("General Codex quota unknown or malformed; deep-review is not guessed")
    if any(window and window["used_percent"] > DOWNSHIFT_ABOVE_PERCENT
           for window in (quota["primary"], quota["secondary"])):
        return model, requested, DEEP_REVIEW_DOWNSHIFT, "general_codex_window_used_percent_above_50"
    return model, requested, requested, None


def verify_catalog(models, model, effort):
    if not isinstance(models, dict):
        raise P.Blocked("Model catalog unavailable; workflow selection cannot be verified")
    found = False
    for entry in models["data"]:
        if isinstance(entry, dict) and entry.get("model") == model and entry.get("hidden") is False:
            found = True
            options = entry.get("supportedReasoningEfforts")
            if isinstance(options, list) and any(isinstance(option, dict) and option.get("reasoningEffort") == effort
                                                 for option in options):
                return
    if found:
        raise P.Blocked("Returned model catalog does not support the selected effort")
    raise P.Blocked("Selected model is missing from the returned catalog"
                    + ("" if models["complete"] else "; catalog pagination incomplete"))


def effective_values(response, model, effort):
    config = response.get("config") if isinstance(response, dict) else None
    if not isinstance(config, dict):
        raise P.Blocked("Effective configuration unavailable; workflow selection cannot be verified")
    # Only these non-secret keys are inspected; the rest of the config is discarded.
    values = {key: config.get(key) for key in ("model", "model_reasoning_effort", *EFFECTIVE_PINS)}
    if values != {"model": model, "model_reasoning_effort": effort, **EFFECTIVE_PINS}:
        raise P.Blocked("Effective model/effort/endpoint does not match the selected pins")
    return values


def ordinary_usage(response):
    allowed = response.get("ordinaryUsageAllowed") if isinstance(response, dict) else None
    return allowed if type(allowed) is bool else None


def now_utc():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def check_workflow(workflow):
    reject_project_routing(Path.cwd())
    binary, native = codex_auth()
    model, requested = WORKFLOWS[workflow]
    reads = app_server_read(binary, native, model, requested, ("rate_limits", "models", "config"))
    quota = general_quota(reads["rate_limits"])
    allowed = ordinary_usage(reads["rate_limits"])
    if allowed is False:
        raise P.Blocked("Backend reports ordinary included usage is not allowed; no workflow selected")
    model, requested, selected, reason = select_effort(workflow, quota)
    verify_catalog(reads["models"], model, selected)
    final = reads["config"]
    if selected != requested:
        # A downshift is confirmed by a fresh read under the selected pins.
        final = app_server_read(binary, native, model, selected, ("config",))["config"]
    values = effective_values(final, model, selected)
    record = {"state": "ready", "workflow": workflow, "tool_version": VERSION,
              "configured_model": model, "configured_effort": selected, "requested_effort": requested,
              "effective_model": values["model"], "effective_effort": values["model_reasoning_effort"],
              "downshift_reason": reason, "quota": quota, "ordinary_usage_allowed": allowed,
              "checked_at": now_utc(), "model_started": False, "thread_started": False, "paid_api_calls": 0}
    return record, binary, native


def note(record):
    print(json.dumps(record, ensure_ascii=False, sort_keys=True), file=sys.stderr, flush=True)


def run_interactive(command):
    # The native TUI keeps the terminal and handles Ctrl-C itself; this process
    # only waits so it can print the finish record. Exec restores default handlers.
    previous = signal.signal(signal.SIGINT, lambda *_: None)
    try:
        with subprocess.Popen(command) as proc:
            code = proc.wait()
    finally:
        signal.signal(signal.SIGINT, previous)
    return 128 - code if code < 0 else code


def start_workflow(workflow):
    record, binary, native = check_workflow(workflow)
    model, effort = record["configured_model"], record["configured_effort"]
    note({"record": "workflow_start", "workflow": workflow, "tool_version": VERSION,
          "model": model, "effort": effort, "requested_effort": record["requested_effort"],
          "downshift_reason": record["downshift_reason"], "quota": record["quota"],
          "started_at": now_utc()})
    started = time.monotonic()
    code = run_interactive(base_command(binary, {**native, "model": model, "model_reasoning_effort": effort}))
    duration = round(time.monotonic() - started, 3)
    try:
        after = general_quota(app_server_read(binary, native, model, effort, ("rate_limits",))["rate_limits"])
    except KeyboardInterrupt:
        after = general_quota(None)
    # Account-wide quota after the session; per-task tokens, tests and rework are not invented.
    note({"record": "workflow_finish", "workflow": workflow, "model": model, "effort": effort,
          "exit_code": code, "duration_seconds": duration, "quota_after": after,
          "token_usage": "unknown", "tests": "unknown", "rework": "unknown", "finished_at": now_utc()})
    return code


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action")
    p = sub.add_parser("start", help="Open the existing Codex session entry point")
    p.add_argument("--workflow", choices=tuple(WORKFLOWS),
                   help="Explicit future workflow pins; omitted keeps the default entry point unchanged")
    p = sub.add_parser("check", help="Read-only app-server quota/catalog/config check for a workflow")
    p.add_argument("--workflow", choices=tuple(WORKFLOWS), required=True)
    p = sub.add_parser("doctor", help="Read auth metadata; --providers also makes read-only GETs")
    p.add_argument("--providers", action="store_true")
    p = sub.add_parser("ask", help="One bounded subscription request; paid routes fail closed")
    p.add_argument("--task", type=Path, required=True)
    p.add_argument("--context", type=Path, required=True)
    p.add_argument("--state-dir", type=Path, default=Path.home() / ".local/state/model-routing")
    args = parser.parse_args(argv)
    workflow = getattr(args, "workflow", None)
    try:
        config = runtime_config()
        if args.action in (None, "start") and workflow is None:
            reject_project_routing(Path.cwd())
            binary, native = codex_auth()
            os.execv(str(binary), base_command(binary, native))
        elif args.action == "start":
            return start_workflow(workflow)
        elif args.action == "check":
            emit(check_workflow(workflow)[0])
        elif args.action == "doctor":
            emit(doctor(args.providers))
        elif args.action == "ask":
            result = ask(config, P.read_json(args.task), args.context, args.state_dir)
            emit(result)
            return 0 if result["state"] == "completed" else 1
        return 0
    except P.Blocked as exc:
        emit({"state": "blocked", "reason": str(exc), "paid_api_calls": 0})
        return 78
    except OSError:
        emit({"state": "blocked", "reason": "Local state or CLI unavailable; details suppressed", "paid_api_calls": 0})
        return 78


if __name__ == "__main__":
    raise SystemExit(main())
