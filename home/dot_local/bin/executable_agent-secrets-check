#!/usr/bin/env python3
"""Inspect the Agents service account without displaying credentials."""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys


class CheckError(Exception):
    pass


def references(path):
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        raise CheckError("env file: unavailable") from None
    names = []
    for number, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        name, separator, value = line.partition("=")
        name = name.strip()
        if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise CheckError(f"env line {number}: invalid assignment")
        if name in names:
            raise CheckError(f"{name}: duplicate assignment")
        value = value.strip()
        if value[:1] in ("'", '"') and len(value) >= 2 and value[-1] == value[0]:
            value = value[1:-1]
        parts = value.removeprefix("op://").split("/")
        if (not value.startswith("op://Agents/") or len(parts) not in (3, 4)
                or any(not part.strip() for part in parts)
                or any(char in value for char in "'\"?#\\$")
                or any(ord(char) < 32 or ord(char) == 127 for char in value)):
            raise CheckError(f"{name}: invalid reference (expected op://Agents/item/[section/]field)")
        names.append(name)
    return names


def op_json(args):
    try:
        result = subprocess.run(["op-agent", *args], capture_output=True, encoding="utf-8",
                                errors="replace", timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        raise CheckError(f"{args[0]}: unavailable") from None
    if result.returncode:
        raise CheckError(f"{args[0]}: failed (details hidden)")
    try:
        return json.loads(result.stdout)
    except (ValueError, TypeError):
        raise CheckError(f"{args[0]}: unexpected response (details hidden)") from None


def metadata():
    account = op_json(["whoami", "--format", "json"])
    account_type = account.get("user_type") if isinstance(account, dict) else None
    if account_type not in ("SERVICE_ACCOUNT", "USER"):
        account_type = "unknown"
    print(f"account type: {account_type}")
    if account_type != "SERVICE_ACCOUNT":
        raise CheckError("account: expected a service account")
    vaults = op_json(["vault", "list", "--format", "json"])
    if not isinstance(vaults, list) or any(not isinstance(vault, dict)
                                          or not isinstance(vault.get("name"), str) for vault in vaults):
        raise CheckError("vault: unexpected response (details hidden)")
    names = [vault["name"] for vault in vaults]
    print("vaults: " + json.dumps(names, ensure_ascii=False))
    if names != ["Agents"]:
        raise CheckError("vault scope: expected Agents only")
    items = op_json(["item", "list", "--vault", "Agents", "--format", "json"])
    if not isinstance(items, list):
        raise CheckError("item: unexpected response (details hidden)")
    print(f"Agents: {len(items)} item(s)")


def resolve(path, names):
    if not names:
        raise CheckError("env references: none to resolve")
    # Only booleans cross back from the injected environment; -I ignores Python env settings.
    checker = "import json, os, sys; print(json.dumps([bool(os.environ.get(n)) for n in sys.argv[1:]]))"
    present = op_json(["run", "--env-file", str(path), "--", sys.executable, "-I", "-c", checker, *names])
    if (not isinstance(present, list) or len(present) != len(names)
            or any(type(value) is not bool for value in present)):
        raise CheckError("run: unexpected response (details hidden)")
    for name, exists in zip(names, present):
        print(f"{name}: {'present' if exists else 'absent'}")
    return all(present)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env-file", type=Path,
                        default=Path.home() / ".config/agents/secrets.env",
                        help="reference-only env file (default: ~/.config/agents/secrets.env)")
    parser.add_argument("--resolve", action="store_true",
                        help="resolve references and report only whether each variable is nonempty")
    args = parser.parse_args()
    try:
        names = references(args.env_file)
        if not names:
            print("env references: none")
        for name in names:
            print(f"{name}: Agents reference")
        metadata()
        return 0 if not args.resolve or resolve(args.env_file, names) else 1
    except CheckError as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
