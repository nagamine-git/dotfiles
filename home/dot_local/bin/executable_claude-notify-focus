#!/usr/bin/env bash
# Claude Code のいる herdr のペインへ移り、Ghostty のウィンドウを前に出す。
#   claude-notify-focus --herdr <workspace_id> <tab_id> <pane_id> [space 名]
#   claude-notify-focus --last   claude-notify が最後に記録したペイン (Hyprland の Super+Shift+R)
# herdr のデスクトップ通知はクリックしてもペインへ移らないので、その代わりに使う。
set -euo pipefail

workspace=""; tab=""; pane=""; session=""
case "${1:-}" in
  --herdr)
    workspace="${2:-}"
    tab="${3:-}"
    pane="${4:-}"
    # Ghostty のウィンドウを探す文字列。herdr は既定で端末のタイトルに space 名を出す
    session="${5:-}"
    ;;
  --last)
    last="${XDG_RUNTIME_DIR:-/tmp}/claude-code-notify/last_herdr"
    [ -r "$last" ] || exit 1
    { IFS= read -r workspace; IFS= read -r tab; IFS= read -r pane; IFS= read -r session; } < "$last" || true
    ;;
  *)
    echo "usage: claude-notify-focus --herdr <workspace_id> <tab_id> <pane_id> [space 名] | --last" >&2
    exit 2
    ;;
esac

[ -z "$workspace" ] && exit 1

herdr_bin="${HERDR_BIN_PATH:-herdr}"
# agent focus は space とタブごとそのペインへ移る (CLI の pane focus は隣へ動くだけ)。
# ペインに Claude がもういなければタブへ、タブも閉じていれば space へ移る
"$herdr_bin" agent focus "$pane" >/dev/null 2>&1 \
  || "$herdr_bin" tab focus "$tab" >/dev/null 2>&1 \
  || "$herdr_bin" workspace focus "$workspace" >/dev/null 2>&1 \
  || true

if command -v hyprctl >/dev/null 2>&1; then
  target_addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg session "$session" '
    map(select((.class // "") | ascii_downcase == "ghostty"))
    | map(select((.title // "") | contains($session)))
    | .[0].address // empty
  ')

  if [ -z "$target_addr" ]; then
    target_addr=$(hyprctl clients -j 2>/dev/null | jq -r '
      map(select((.class // "") | ascii_downcase == "ghostty"))
      | .[0].address // empty
    ')
  fi

  if [ -n "$target_addr" ]; then
    hyprctl dispatch "hl.dsp.focus({ window = 'address:${target_addr}' })" >/dev/null 2>&1 || true
  fi
fi
