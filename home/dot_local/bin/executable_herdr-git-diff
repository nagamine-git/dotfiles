#!/usr/bin/env bash
# herdr の Alt+G (config.toml の type = "shell") から呼ばれる。
# フォーカス中のペインの前面が Neovim なら、ポップアップは開かずその Neovim で :LazygitFloatToggle を実行する。
# それ以外 (sim を含む) や判定に失敗したときは、ペインの cwd で lazygit のポップアップを開く (プラグイン git-diff)。
set -u

h="${HERDR_BIN_PATH:-herdr}"
pane="${HERDR_ACTIVE_PANE_ID:-}"

is_nvim_foreground() {
  [ -n "$pane" ] || return 1
  local info
  info="$("$h" pane process-info --pane "$pane" 2>/dev/null)" || return 1
  # 名前か argv[0] の basename が nvim のとき (nvim-qt や sim は対象外)
  printf '%s' "$info" | jq -e '
    .result.process_info.foreground_processes
    | any(.[]; (.name == "nvim") or ((.argv[0] // "" | split("/") | last) == "nvim"))' >/dev/null 2>&1
}

if is_nvim_foreground; then
  # C-\ C-n は挿入・コマンドライン・ターミナル・演算子待ちのどのモードでもノーマルモードへ戻す (入力は残らない)
  if "$h" pane send-text "$pane" "$(printf '\034\016:LazygitFloatToggle\r')" >/dev/null 2>&1; then
    exit 0
  fi
fi

# --cwd が無いとプラグインのディレクトリで開く。HERDR_ACTIVE_PANE_CWD は一番外のシェルの cwd なので、
# 中で動くシェルなどに合わせて前面のプロセスの cwd を先に見る
cwd=""
if [ -n "$pane" ]; then
  cwd="$("$h" pane get "$pane" 2>/dev/null | jq -r '.result.pane.foreground_cwd // empty' 2>/dev/null)"
fi
exec "$h" plugin pane open --plugin nagamine.git-diff --entrypoint lazygit \
  --cwd "${cwd:-${HERDR_ACTIVE_PANE_CWD:-$PWD}}"
