# /etc/environment の BROWSER=firefox (CachyOS 既定) をシェルでも上書きする。systemd --user 側は environment.d/browser.conf
export BROWSER=google-chrome-stable

# ZEED_TELEMETRY_READ_TOKEN は chezmoi 管理外のファイルから読む (chezmoi が 1Password を呼ばないように)。
# 新しいホストでは一度だけ: op read 'op://Personal/Zeed Telemetry Read Token/credential' > ~/.config/zeed/telemetry-read-token && chmod 600 ~/.config/zeed/telemetry-read-token
[[ -r ~/.config/zeed/telemetry-read-token ]] && export ZEED_TELEMETRY_READ_TOKEN="$(<~/.config/zeed/telemetry-read-token)"
