{{- $m := .pi.models -}}
{{- $out := dict "default" $m.default "strong" $m.strong "peak" $m.peak "light" $m.light -}}
{{- with (get .pi "router") -}}
{{-   if hasKey . "weights" -}}
{{-     $out = set $out "weights" .weights -}}
{{-   end -}}
{{-   if hasKey . "scarce" -}}
{{-     $out = set $out "scarce" .scarce -}}
{{-   end -}}
{{- end -}}
{{ $out | toPrettyJson }}
