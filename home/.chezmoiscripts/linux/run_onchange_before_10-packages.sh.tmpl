{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Linux (Arch 系) のパッケージを system/pkglist.txt に合わせて入れる。入っていないものだけを入れ、更新は普段の paru -Syu に任せる。
# pkglist.txt が変わったときだけ chezmoi が再実行する: {{ include (joinPath .chezmoi.workingTree "system/pkglist.txt") | sha256sum }}
set -eu
cd "{{ .chezmoi.workingTree }}/system"

# 1Password のリポジトリの署名鍵 (AUR の 1password のビルドに要る)
curl -sS https://downloads.1password.com/linux/keys/1password.asc | gpg --import || echo "⚠ 1password GPG key import 失敗 (継続)"

# pkglist で入れ替えたパッケージ (旧:新)。衝突は --noconfirm だと「N」になり一括インストール全体が失敗するので、
# 公式リポジトリの新パッケージに替えるものは先に旧を外す。
replaced_pkgs=(waybar-git:waybar)
for pair in "${replaced_pkgs[@]}"; do
  old="${pair%%:*}"; new="${pair##*:}"
  # 旧パッケージが新の名前を provides していると `pacman -Q 新` も成功するので、実体の名前で比べる
  if pacman -Q "$old" >/dev/null 2>&1 && [ "$(pacman -Qq "$new" 2>/dev/null)" != "$new" ]; then
    sudo pacman -Rdd --noconfirm "$old" && sudo pacman -S --needed --noconfirm "$new" || echo "⚠ $old → $new の入れ替えに失敗 (継続)"
  fi
done

# コメントと空行を除いてから、入っていないものだけ入れる (paru/pacman は stdin の '#' をパッケージ名扱いする)。
# --needed でも AUR の更新版をビルドしに行き、瞬断で失敗したり長時間かかったりするため、更新はしない
mapfile -t pkgs < <(grep -vE '^[[:space:]]*(#|$)' pkglist.txt | xargs pacman -T 2>/dev/null || true)
if [ "${#pkgs[@]}" -eq 0 ]; then
  echo "pkglist のパッケージはすべて導入済み"
elif ! paru -S --needed --noconfirm "${pkgs[@]}"; then
  # 1 つの衝突・ビルド失敗で他まで入らないのを防ぐため、1 つずつ入れ直す
  echo "⚠ 一括インストールに失敗。1 つずつ入れ直す"
  for pkg in "${pkgs[@]}"; do
    if ! out="$(paru -S --needed --noconfirm "$pkg" 2>&1)"; then
      echo "  ⚠ $pkg のインストールに失敗 (継続): $(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1)"
    fi
  done
fi
{{ end -}}
