{{/*
  Monitor 設定。Hyprland の monitor 宣言はここに集約。
  - eDP-1: ホスト別 scale (fp7-e14=1.25 / それ以外=1)
  - S270ES (am5-itx の 27" 4K): 3840x2160@120・VRR 無効を明示する (preferred は 60Hz)。
    scale 1 だと ~163PPI 等倍で文字極小のため 1.5 (2560x1440 相当)。
    120Hz は実機でモード反映を確認済み。長時間・サスペンド復帰時の安定性は未確認。
  - 外部出力: auto (接続時に preferred)
  lid 開閉は hyprland.lua 内の bind (switch:*:Lid Switch) で hyprctl eval の hl.monitor を動的制御。
  VRR は 4K@120Hz HDMI で黒落ちしたため、S270ES はモニタ初期化時から vrr = 0 にする。
  他のモニタには起動時に hypr-vrr-off.sh が vrr = 0 を再適用する。
  hypr-vrr-off.sh は本ファイルの各行から output を読むので、1 行 1 モニタの形式を保つこと。
*/ -}}
{{- if eq .chezmoi.hostname "fp7-e14" }}
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1.25 })
{{- else }}
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1 })
{{- end }}
-- 黒画面が再発したら、この S270ES の mode を 3840x2160@60 に戻す (vrr = 0 は維持)。
hl.monitor({ output = "desc:IPS Inc. (Intellectual Property Solutions Inc.) S270ES 0000000000001", mode = "3840x2160@120", position = "auto", scale = 1.5, vrr = 0 })
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
