-- speed の単位は 100ms。旧設定は global 0.175 (約 17ms = 60Hz で 1 コマ) で実質的に動きが無かった。
-- 動きは「何がどこから来たか」を示すだけにし、どれも 80–150ms に収める。
-- ワークスペースの切替えはキーを押すたびに画面全体が動くので、横スライドではなく短いフェードにする。
hl.curve("easeOutQuint", { type = "bezier", points = { {0.23, 1}, {0.32, 1} } })
hl.curve("linear", { type = "bezier", points = { {0, 0}, {1, 1} } })
hl.curve("almostLinear", { type = "bezier", points = { {0.5, 0.5}, {0.75, 1} } })

hl.animation({ leaf = "global", enabled = true, speed = 1.2, bezier = "easeOutQuint" })
hl.animation({ leaf = "border", enabled = true, speed = 1.0, bezier = "easeOutQuint" })
hl.animation({ leaf = "windowsIn", enabled = true, speed = 1.5, bezier = "easeOutQuint", style = "popin 90%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 1.0, bezier = "linear", style = "popin 90%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = 1.2, bezier = "easeOutQuint" })
hl.animation({ leaf = "fade", enabled = true, speed = 1.0, bezier = "almostLinear" })
hl.animation({ leaf = "layersIn", enabled = true, speed = 1.2, bezier = "easeOutQuint", style = "fade" })
hl.animation({ leaf = "layersOut", enabled = true, speed = 0.8, bezier = "linear", style = "fade" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 1.0, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 1.2, bezier = "easeOutQuint", style = "fade" })

