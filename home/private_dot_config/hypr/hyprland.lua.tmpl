-- === LAPTOP LID ===
hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd([[hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })']]), { locked = true })
-- hl.monitor は同じ output の既存ルールへマージするので、再有効化には disabled = false が要る。
{{- if eq .chezmoi.hostname "fp7-e14" }}
-- 蓋開け: 内蔵パネルの scale は monitors.lua と一致させ 1.25。
-- 素早い開閉のチャタリングや amdgpu PSR スタックでパネルが黒落ちするため、再有効化後に dpms on を明示する
-- (fp7-e14 は hypridle 不使用で DPMS 復帰の保険が無いため必須)。
-- さらに suspend 復帰と重なると hl.monitor での再有効化が取りこぼされ eDP-1 が disable のまま残る事故が
-- あるため、monitors.lua を読み直す reload を保険として最後に撃ち、確実に内蔵パネルを復活させる。
hl.bind("switch:off:Lid Switch", hl.dsp.exec_cmd([[hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1.25, disabled = false })' && hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' && hyprctl reload]]), { locked = true })
{{- else }}
hl.bind("switch:off:Lid Switch", hl.dsp.exec_cmd([[hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1, disabled = false })' && hyprctl dispatch 'hl.dsp.dpms({ action = "on" })']]), { locked = true })
{{- end }}

