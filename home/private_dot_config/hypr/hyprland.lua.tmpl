--- AUTOSTART ---
-----------------

hl.on("hyprland.start", function()
    hl.exec_cmd("fcitx5 -d --replace")
    {{ if eq .chezmoi.hostname "am5-itx" -}}
    -- ログイン時に ChatGPT と Codex の app-server daemon を起動する。起動済みならどちらも既存のものを使う
    -- (ChatGPT は single-instance。daemon start は動いていないときだけ起動する)
    -- ChatGPT は chatgpt-launch から起動し、メモリ上限を付ける (docs/chatgpt-launch.md)
    hl.exec_cmd("~/.local/bin/chatgpt-launch")
    hl.exec_cmd("~/.local/bin/codex app-server daemon start")
    {{ end -}}
    hl.exec_cmd("1password --silent &")
    hl.exec_cmd("hyprvoice serve &")
    -- waybar・swaync・hyprpaper・cliphist・hypridle は systemd のユーザーサービス (パッケージ同梱) で起動する。
    -- graphical-session.target.wants に置いたシンボリックリンクで有効にしてあり、Hyprland の準備が整ってから立ち上がり、
    -- 落ちたら systemd が立ち上げ直す (Restart=on-failure)。waybar は起動前に島の色を壁紙に合わせる (waybar.service.d/tint.conf)
    hl.exec_cmd("swayosd-server &")
    -- ランチャー (Super+Space) の常駐サーバー。toggle などのコマンドはこれに頼む
    hl.exec_cmd("vicinae server")
    -- hypridle は dpms off の直後に落ちると画面が黒いまま戻らなくなる (2026-05-29 調査)。以前はここで bash の無限ループで
    -- 立ち上げ直していたが、今は hypridle.service の Restart=on-failure に任せる。fp7-e14 (常時ホスト) では有効にしない
    -- polkit 認証エージェント: 1Password の system-auth アンロック / SSH署名承認ダイアログに必須。
    -- 不在だと 1Password agent が署名を即拒否し、SSH鍵認証が "agent refused operation" で全滅する。
    hl.exec_cmd("/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &")
    hl.exec_cmd("systemctl --user start darkman.service &")
    -- VRR は 4K@120Hz HDMI でパネルが黒落ちするため、起動時にモニタへ vrr = 0 を明示再適用する
    -- (0.56 までの調査で misc:vrr=0 だけではモニタ初期化時に効かなかったため。経緯は同スクリプト冒頭)。
    hl.exec_cmd("~/.local/bin/hypr-vrr-off.sh &")
    hl.exec_cmd("~/.local/bin/claude-usage-notify &")
    hl.exec_cmd("~/.local/bin/droidcam.sh &")
    -- sleep_backup は exec-once では機能せず (起動時点で「スリープ復帰5分以内」を満たさず
    -- 即終了 + sudo timeshift が対話不能)、systemd timer 方式も未運用のまま 2026-07 に撤去済み。
    hl.exec_cmd("way-thumbsense --exclude-left=10 --exclude-right=10 &")
    -- Web 会議のリングライト: カメラを使っている間だけ画面の縁を光らせる (Super+F12・waybar で手動の点け消しと設定)
    hl.exec_cmd("~/.local/bin/ringlight watch &")
end)

