{
  "_note": "loop-watch が見張る定期処理。max_age_h は前回の実行からの上限、output は結果ファイルの更新の上限。この端末に無い unit は飛ばす。",
  "loops": [
    {
      "name": "モデル選び (model-radar)",
      "unit": "model-radar.service",
      "max_age_h": 3,
      "output": {"path": "~/.pi/agent/model-scores.json", "max_age_h": 3, "say": "選ぶためのデータが 3 時間以上更新されていない"}
    },
    {
      "name": "GOLD LAB の投稿",
      "unit": "goldlab-cycle.service",
      "max_age_h": 2,
      "bad_tail": {
        "path": "~/ghq/github.com/nagamine-git/sim-shorts/out/logs/goldlab_cycle.log",
        "since": "=== cycle start ===",
        "pattern": "補充まで保留",
        "say": "在庫切れで投稿が止まっている"
      }
    },
    {
      "name": "GOLD LAB の初速記録",
      "unit": "sim-launch-track.service",
      "max_age_h": 2,
      "output": {"path": "~/ghq/github.com/nagamine-git/sim-shorts/out/report/launch_curve.json", "max_age_h": 3, "say": "初速の記録が 3 時間以上更新されていない"}
    },
    {
      "name": "GOLD LAB の集計",
      "unit": "sim-analytics.service",
      "max_age_h": 26
    },
    {
      "name": "GOLD LAB の振り返り",
      "unit": "sim-kpi-pdca.service",
      "max_age_h": 26,
      "output": {"path": "~/ghq/github.com/nagamine-git/sim-shorts/out/report/pdca/LATEST.md", "max_age_h": 26, "say": "振り返りの報告が 1 日以上更新されていない"}
    },
    {
      "name": "GOLD LAB のルール見直し",
      "unit": "sim-rule-review.service",
      "max_age_h": 192,
      "output": {"path": "~/ghq/github.com/nagamine-git/sim-shorts/out/report/rules/LATEST.md", "max_age_h": 192, "say": "ルールの見直しが 8 日以上更新されていない"}
    }
  ]
}
