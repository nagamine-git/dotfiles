{
  "$include": "./config.json",
  "agents": { "defaults": { "workspace": "{{ .chezmoi.homeDir }}/.local/share/openclaw-host/workspace" } },
  "gateway": {
    "mode": "local", "bind": "loopback", "port": 18799,
    "auth": { "mode": "token", "allowTailscale": false },
    "trustedProxies": ["127.0.0.1"],
    "tailscale": { "mode": "off" }
  },
  "discovery": { "mdns": { "mode": "off" } },
  "talk": { "speechLocale": "ja-JP", "realtime": {
    "provider": "openai", "mode": "realtime", "transport": "gateway-relay", "brain": "agent-consult",
    "providers": { "openai": { "model": "gpt-live-1-codex", "speakerVoice": "cove" } }
  } },
  "channels": { "slack": {
    "enabled": true, "mode": "socket",
    "appToken": { "source": "env", "provider": "default", "id": "SLACK_APP_TOKEN" },
    "botToken": { "source": "env", "provider": "default", "id": "SLACK_BOT_TOKEN" },
    "dmPolicy": "allowlist", "allowFrom": ["U03L2HM8Q4X"],
    "groupPolicy": "allowlist", "channels": { "C0CDQP2MLN9": { "users": ["U03L2HM8Q4X"] } },
    "actions": { "messages": false, "pins": false, "memberInfo": false, "emojiList": false, "channels": false }
  } },
  "plugins": { "allow": ["anthropic", "openai", "device-pair", "jev-route", "home-guard", "slack"],
    "load": { "paths": ["{{ .chezmoi.homeDir }}/.local/share/openclaw-host/plugins/jev-route.mjs", "{{ .chezmoi.homeDir }}/.local/share/openclaw-host/plugins/home-guard.mjs", "{{ .chezmoi.homeDir }}/.local/share/openclaw-host/node_modules/@openclaw/slack"] } }
}
