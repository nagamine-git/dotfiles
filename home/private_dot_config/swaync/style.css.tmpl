{{- $c := .theme.colors_elevation -}}
{{- if eq .chezmoi.hostname "fp7-e14" -}}{{- $c = .theme.colors_catppuccin -}}{{- end -}}
{{- $f := .theme.fonts -}}
{{- $sh := .theme.shape -}}
/* 2026-11 の UI 見直し (配色は案 B「エレベーション」= colors_elevation): 不透明・枠線なしで、面の明るさで高さを示す
   (通知センター = 高さ 1、通知と中の部品 = 高さ 2、ボタン・選択 = 高さ 3)。角丸 6・左端の色の帯で緊急度を示す・文字を 13pt に上げる
   (通知は日本語を周辺視野でちらっと読むので、10pt では漢字が小さすぎた。70cm で 13pt は漢字 1 文字が視角約 20 分) */
/* 基本スタイル */
* {
  font-family: '{{ $f.ui }}', '{{ $f.mono }}', sans-serif;
  background-color: transparent;
}

.notification-row {
  outline: none;
}

.notification-row:focus,
.notification-row:hover {
  background: #{{ $c.surface.hex }};
}

.notification {
  background: #{{ $c.bg_light.hex }};
  padding: 12px 14px;
  margin: {{ $sh.gap }}px;
  border-radius: {{ $sh.radius_md }}px;
  border: none;
  font-size: 13pt;
}

.notification-content {
  background: transparent;
  padding: 0;
  margin: 0;
}

.close-button {
  background: #{{ $c.surface.hex }};
  color: rgba({{ $c.text.rgb }}, 1);
  text-shadow: none;
  padding: 0;
  border-radius: {{ $sh.radius_sm }}px;
  margin-top: 8px;
  margin-right: 8px;
}

.close-button:hover {
  background: #{{ $c.primary.hex }};
  color: #{{ $c.bg_dark.hex }};
}

.notification-default-action,
.notification-action {
  background: #{{ $c.bg_light.hex }};
  color: rgba({{ $c.text.rgb }}, 1);
  margin: 4px;
  border-radius: {{ $sh.radius_sm }}px;
  padding: 4px 8px;
}

.notification-default-action:hover,
.notification-action:hover {
  background: #{{ $c.surface.hex }};
}

.notification-default-action {
  background: #{{ $c.bg_light.hex }};
}

.notification-default-action:hover {
  background: #{{ $c.bg_light.hex }};
}

.summary {
  font-size: 13pt;
  font-weight: bold;
  background: transparent;
  color: rgba({{ $c.text.rgb }}, 1);
  text-shadow: none;
}

.time {
  font-size: 10pt;
  font-weight: normal;
  background: transparent;
  color: #{{ $c.text_dim.hex }};
  text-shadow: none;
  margin-right: 16px;
}

.body {
  font-size: 13pt;
  font-weight: normal;
  background: transparent;
  color: #{{ $c.text.hex }};
  text-shadow: none;
}

.control-center {
  background: #{{ $c.bg_medium.hex }};
  border: none;
  border-radius: {{ $sh.radius_lg }}px;
  margin: {{ $sh.gap }}px;
}

.control-center-list {
  background: transparent;
}

.control-center-list-placeholder {
  opacity: 0.5;
  margin: 20px;
}

.floating-notifications {
  background: transparent;
}

.blank-window {
  background: alpha(black, 0.35);
}

.widget-title {
  color: rgba({{ $c.text.rgb }}, 1);
  background: #{{ $c.bg_light.hex }};
  padding: 8px 12px;
  margin: 12px;
  border-radius: {{ $sh.radius_md }}px;
  font-size: 11pt;
  font-weight: bold;
}

.widget-title > button {
  font-size: 10pt;
  color: rgba({{ $c.text.rgb }}, 1);
  background: #{{ $c.surface.hex }};
  border-radius: {{ $sh.radius_sm }}px;
  padding: 4px 8px;
}

.widget-title > button:hover {
  background: #{{ $c.primary.hex }};
  color: #{{ $c.bg_dark.hex }};
}

.widget-dnd {
  color: rgba({{ $c.text.rgb }}, 1);
  background: #{{ $c.bg_light.hex }};
  padding: 8px 12px;
  margin: 12px;
  border-radius: {{ $sh.radius_md }}px;
  font-size: 10pt;
}

.widget-dnd > switch {
  border-radius: 8px;
  background: #{{ $c.surface.hex }};
}

.widget-dnd > switch:checked {
  background: rgba({{ $c.accent.rgb }}, 0.9);
}

/* 緊急度は左端 4px の色の帯 (低: 灰 / 通常: 青 / 緊急: 赤 + 明るめの背景) */
.urgency-low {
  background: #{{ $c.bg_light.hex }};
  border-left: 4px solid #{{ $c.text_dim.hex }};
}

.urgency-normal {
  background: #{{ $c.bg_light.hex }};
  border-left: 4px solid #{{ $c.primary.hex }};
}

.urgency-critical {
  background: #{{ $c.surface.hex }};
  border-left: 4px solid #{{ $c.error.hex }};
}

/* 通知タイトル */
.notification .notification-title {
  font-weight: bold;
  margin-bottom: 4px;
}

/* 通知本文 */
.notification .notification-body {
  opacity: 0.9;
}

/* 通知アイコン */
.notification .notification-icon {
  margin-right: 8px;
}

/* プログレスバー */
.notification .notification-progress {
  background-color: rgba(128, 128, 128, 0.4);
  border-radius: 4px;
  height: 4px;
  margin-top: 8px;
}

.notification .notification-progress .notification-progress-bar {
  background-color: rgba(128, 128, 128, 1);
  border-radius: 4px;
  height: 100%;
}

/* 空の通知リスト */
.control-center .control-center-list .placeholder {
  opacity: 0.7;
  font-style: italic;
  margin: 20px;
  text-align: center;
}
