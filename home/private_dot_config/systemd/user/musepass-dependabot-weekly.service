[Unit]
Description=Musepass の Dependabot アラート週次まとめ (gh で集計 → Slack Incoming Webhook)
After=network-online.target
Wants=network-online.target

# タイマーは Webhook の 1Password 項目 (Agents/musepass-dependabot-webhook) を作るまで enable しない。作ったら:
#   systemctl --user enable --now musepass-dependabot-weekly.timer
# op run は子に OP_SERVICE_ACCOUNT_TOKEN をそのまま渡すので、env -u で外して gh・curl に届かせない。

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/op-agent run --env-file %h/.config/agents/musepass-dependabot.env -- /usr/bin/env -u OP_SERVICE_ACCOUNT_TOKEN %h/.local/bin/musepass-dependabot-weekly
