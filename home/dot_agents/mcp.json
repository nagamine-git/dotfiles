{
  "mcpServers": {
    "chrome": {
      "command": "agent-chrome-mcp",
      "args": [],
      "clients": ["pi"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "clients": ["pi"]
    },
    "freee": {
      "command": "npx",
      "args": ["-y", "freee-mcp@latest"]
    },
    "google-workspace": {
      "command": "uvx",
      "args": ["workspace-mcp"],
      "secrets": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET"]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "clients": ["pi"]
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp?readonly=true"
    },
    "preship": {
      "command": "node",
      "args": ["/home/tsuyoshi/ghq/github.com/efg-technologies/preship-app/src/mcp.js"],
      "clients": ["pi"]
    },
    "tavily-mcp": {
      "command": "agent-tavily-mcp",
      "args": []
    },
    "toggl": {
      "command": "npx",
      "args": ["-y", "@verygoodplugins/mcp-toggl"],
      "secrets": ["TOGGL_API_KEY"]
    },
    "zeed-atlas": {
      "type": "http",
      "url": "https://search.zeed.run/mcp"
    }
  }
}
