# ソースから消したファイルの配置先。apply のときにホームからも消す (chezmoi はソースから
# 消しただけではホームのファイルを消さない)。テンプレートとして読まれる。
# パターンはホームからの相対パスで、glob として当てる。ほかの用途のファイルを巻き込まないよう、
# 1 つずつ正確に書き、そのファイルを配置していた OS に限る。全機で消えたら外してよい。
.local/bin/biz_start.sh
# claude-code-router は使わなくなった (2026-11)
.local/bin/ccr-start.sh
{{- if ne .chezmoi.os "darwin" }}
.local/bin/unified_launcher.sh
.local/bin/desktop-apps-tmux
.local/bin/integrate-appimage.sh
.local/bin/uninstall-appimage.sh
.local/bin/fix-brave-pwa.sh
.config/desktop-apps/tmux.conf
# 中身はこのリポジトリが置いた data/Company/EFG.{json,txt} だけ (両機で確認済み)
.config/autokey
.config/hypr/hyprsession.conf
.config/cursor-flags.conf
.config/electron27-flags.conf
.local/bin/hypr_auto_perfmonitor.sh
# GPUメーターは Python標準ライブラリ、描画効果の切替は Hyprland Lua に統合した
.config/waybar/scripts/gpu_status.sh
.local/bin/lib_hypr_perfmode.sh
# マイクの S/N 計測。呼び出し元も利用履歴も無かった (2026-11)
.local/bin/mic-snr.sh
bin/server.sh
# 2026-11 の UI 見直しで waybar を不透明の暗い島にし、壁紙に合わせた明暗の切替をやめた
.local/bin/waybar-auto-theme.sh
.config/waybar/colors.css
# リングライトの見張り役は ringlight watch に統合した
.local/bin/ringa-camera-watch
# Wolow の導入物はリポジトリの system/wolow から入れるようにした (ホームの直下には置かない)
install.sh
uninstall.sh
50-wolow-companion.rules
# Musepass の Dependabot 週次まとめは使わないことにした (タイマーは一度も有効にしていない)
.local/bin/musepass-dependabot-weekly
.config/systemd/user/musepass-dependabot-weekly.service
.config/systemd/user/musepass-dependabot-weekly.timer
.config/agents/musepass-dependabot.env
# swaync は swaync.service で起動するようにした
.local/bin/swaync_launcher.sh
# rofi の 3 つの用途 (Exit Node・クリップボード履歴・ショートカット一覧) は vicinae dmenu に移した
.config/rofi
{{- end }}

# AI エージェント向けの道具は am5-itx だけに置く (本体は agent-tools)。ほかのホストに残った古いコピーを消す
{{- if ne .chezmoi.hostname "am5-itx" }}
.local/bin/claude-delegate
{{- end }}
