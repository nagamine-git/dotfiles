# Font Settings
font-family = "{{ .theme.fonts.terminal }}"
font-size = 12
font-feature = -liga
font-feature = -calt
{{- if eq .chezmoi.os "darwin" }}
theme = Gruvbox Material
# Option キーを Alt として送信 (tmux の M-m 最大化トグル等の M- バインドに必須)
macos-option-as-alt = true
# Cmd+数字を herdr の space 切り替えに渡す。既定のタブ切り替えは super+N と super+digit_N の両方にある (9 は super+9 だけ)
keybind = super+1=unbind
keybind = super+digit_1=unbind
keybind = super+2=unbind
keybind = super+digit_2=unbind
keybind = super+3=unbind
keybind = super+digit_3=unbind
keybind = super+4=unbind
keybind = super+digit_4=unbind
keybind = super+5=unbind
keybind = super+digit_5=unbind
keybind = super+6=unbind
keybind = super+digit_6=unbind
keybind = super+7=unbind
keybind = super+digit_7=unbind
keybind = super+8=unbind
keybind = super+digit_8=unbind
keybind = super+9=unbind
{{- else }}
theme = Hybrid
# Linux の Ghostty は既定で Alt+1..9 を自分のタブ切り替えに使う。herdr の N 番目のエージェント (focus_agent) に届くよう外す。
# Ctrl+1..9 は Ghostty の既定では使われず (Ctrl+0 だけ文字サイズのリセット)、kitty keyboard protocol で herdr に届く
{{- range $i := untilStep 1 10 1 }}
keybind = alt+{{ $i }}=unbind
keybind = alt+digit_{{ $i }}=unbind
{{- end }}
{{- end }}

# Hyprland Optimization (Minimal & Clean)
window-decoration = false
gtk-titlebar = false
{{- if ne .chezmoi.os "darwin" }}

# 単一インスタンスを切り、1ウィンドウ = 1プロセスにする (2026-08-23)。
# am5-itx は deep(S3) からの復帰のたびに amdgpu が MODE1 reset を打っており
# (suspend 16回 : MODE1 reset 16回で完全一致)、HYPR_IGNORE_GPU_RESETS=1 で
# Hyprland が生き延びる代わりにクライアントの GL コンテキストが lost したまま残る。
# 既存ウィンドウは描画を維持できるが新規サーフェスの初期化に失敗するため、
# 既定の detect (= 新窓は必ず既存プロセスが作る) だと数日稼働後に
# 「新しいウィンドウだけ中身が出ず壁紙が透ける」状態に全滅する。
# 1窓1プロセスなら腐ったプロセスを引きずらない。代償はメモリと起動時間、
# および linux-cgroup = single-instance の分離が効かなくなること。
gtk-single-instance = false
{{- end }}

# Performance & Aesthetics
confirm-close-surface = false
background-opacity = 0.99
mouse-hide-while-typing = true
# カーソル点滅オフ: 点滅は周辺視野を奪う動的刺激で注意を不随意に引く (注意捕捉の低減)。
cursor-style-blink = false
