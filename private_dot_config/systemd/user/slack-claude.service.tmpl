[Unit]
Description=Slack から Claude Code に依頼を受ける bot ({{ .chezmoi.hostname }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment="PATH=%h/.local/bin:%h/.local/share/mise/installs/node/lts/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/op-agent run --env-file %h/.config/agents/slack.env -- %h/.local/bin/slack-claude serve
Restart=on-failure
# 鍵が vault にまだ無い間は起動に失敗し続けるので、連打しない間隔にする
RestartSec=120
TimeoutStopSec=45
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
