[Unit]
Description=tower (新規事業ループの司令塔。PWA で状況を見る) ({{ .chezmoi.hostname }})
After=network-online.target
Wants=network-online.target

# 初回だけ、tailnet の中に出す設定を手で入れる (unit では実行しない。設定は tailscaled に残る):
#   tailscale serve --bg --https=8750 http://127.0.0.1:8750
# tower は 127.0.0.1 だけで待ち受け、Tailscale-User-Login が --allow-login と一致する要求だけ通す。
# Host は --allow-host の名前 (と loopback) だけ通す。tailscale serve が Host を tailnet の名前のまま渡しても、127.0.0.1:8750 に書き換えても通るようにする。
# op run は子に OP_SERVICE_ACCOUNT_TOKEN (Agents vault の service account のトークン) をそのまま渡すので、env -u で外して tower に届かせない
# (model-route もこの変数があると安全側に止まり、Codex の欄が終了コード 78 のエラーになる)。

[Service]
# --dispatch: tower ラベルの Linear の Issue を Claude Code（Opus、auto モード）で自律実行する（EFG-201、ADR 0002）。
# 止めるときは ~/.config/tower/pause を置く（実行中のものは続く）。最初の数件を見届けるまでは同時に 1 件だけ動かす。
Type=simple
WorkingDirectory=%h
# --dispatch で起動する Claude Code が git・gh・cargo・node などを使えるよう、対話の PATH に近づける
Environment="PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/.local/share/mise/installs/node/lts/bin:%h/.cargo/bin:/usr/lib/rustup/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/op-agent run --env-file %h/.config/agents/tower.env -- /usr/bin/env -u OP_SERVICE_ACCOUNT_TOKEN %h/.local/bin/tower serve --listen 127.0.0.1:8750 --allow-login tsuyoshi.nagamine@efg-technologies.com --allow-host am5-itx.tailcda87f.ts.net --dispatch --max-concurrent 1
Restart=on-failure
RestartSec=30
# 実行中の Claude が結果を書けるよう、tower の打ち切りの猶予 (30 秒) より長くする
TimeoutStopSec=45
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
