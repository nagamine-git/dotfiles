[Unit]
Description=tower (新規事業ループの司令塔。PWA で状況を見る) ({{ .chezmoi.hostname }})
After=network-online.target
Wants=network-online.target

# 初回だけ、tailnet の中に出す設定を手で入れる (unit では実行しない。設定は tailscaled に残る):
#   tailscale serve --bg --https=8750 http://127.0.0.1:8750
# tower は 127.0.0.1 だけで待ち受け、Tailscale-User-Login が --allow-login と一致する要求だけ通す。
# Host は --allow-host の名前 (と loopback) だけ通す。tailscale serve が Host を tailnet の名前のまま渡しても、127.0.0.1:8750 に書き換えても通るようにする。
# op run は子に OP_SERVICE_ACCOUNT_TOKEN (Agents vault の service account のトークン) をそのまま渡すので、env -u で外して tower に届かせない
# (model-route もこの変数があると安全側に止まり、Codex の欄が終了コード 78 のエラーになる)。

[Service]
# --dispatch: tower ラベルの Linear の Issue を Claude Code（Opus、auto モード）で自律実行する（EFG-201、ADR 0002）。
# 止めるときは ~/.config/tower/pause を置く（実行中のものは続く）。同時に 2 件まで動かす（2026-11-02 の本人の判断。11/1〜11/2 の 46 件で行方不明 0 件だったため、1 件から上げた）。
# --jev: 起動ごとに Typesafe の Jev に経路を影で選ばせて記録する（実際の起動は変えない。EFG-181、ADR 0005）。送るのは種類・ラベル・伏せ字の題名だけ。月の上限は tower 側のカウンタで守る。戻すときはこのフラグを消して再起動する。
# --slack-replies: 本人が Slack の通知のスレッドに書いた返信で、その Issue の続きを実行する（EFG-220、ADR 0004）。戻すときはこのフラグを消して再起動する。
# --numbers: PWA に «数字» のタブを出す（EFG-287、2026-11-02 の本人の依頼「EFGダッシュボードと統合できる？Towerをベース・メインにしたいな！」）。
# 10 分ごとに zeed-telemetry-worker の手元の clone を fetch して compass-data.json を読むだけで、新しい鍵は使わない。戻すときはこのフラグを消して再起動する。
# --kgi: PWA に «KGI» のタブを出す（EFG-352、2026-11-11 の本人の依頼）。60 秒ごとに ~/.local/state/tower/kgi.json を読むだけで、新しい鍵は使わない。戻すときはこのフラグを消して再起動する。
# --local-login: am5-itx の中のブラウザ用に 127.0.0.1:8751 を開く（EFG-355、ADR 0008、2026-11-11 に本人が A を選択）。tailscale serve では公開しない。
# 開くのは am5-itx の端末で `tower open`。戻すときはこのフラグを消して再起動し、`tower open --revoke` で Cookie を全部無効にする。
# 2026-11-11 に画面のために起動し直したとき、Issue の自律実行は ~/.config/tower/pause で止めたままにした（2026-11-03 の «全部止めた» を変えない）。再開は本人の判断で pause を消す。
Type=simple
WorkingDirectory=%h
# --dispatch で起動する Claude Code が git・gh・cargo・node などを使えるよう、対話の PATH に近づける
Environment="PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/.local/share/mise/installs/node/lts/bin:%h/.cargo/bin:/usr/lib/rustup/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/op-agent run --env-file %h/.config/agents/tower.env -- /usr/bin/env -u OP_SERVICE_ACCOUNT_TOKEN %h/.local/bin/tower serve --listen 127.0.0.1:8750 --allow-login tsuyoshi.nagamine@efg-technologies.com --allow-host am5-itx.tailcda87f.ts.net --dispatch --max-concurrent 2 --slack-channel U03L2HM8Q4X --slack-replies --jev --numbers --kgi --local-login
Restart=on-failure
RestartSec=30
# 実行中の Claude が結果を書けるよう、tower の打ち切りの猶予 (30 秒) より長くする
TimeoutStopSec=45
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
