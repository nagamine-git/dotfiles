# herdr のキー設定。tmux (dot_tmux.conf.tmpl と tmux-tilit) のよく使うキーのうち、今の tmux より多くの入力を
# 奪わないものだけを移している。herdr に同じ操作が無い自動整列・直前の workspace・ポップアップは [[keys.command]] で足す。
# space の切り替えは tmux に無かったキーを足す例外。Mac の Cmd+数字はアプリに届かないキー、Linux の Ctrl+数字はアプリがほとんど使わないキー。
# 確認: herdr config check / 反映: herdr server reload-config

# 初回案内を済ませた状態。無いと起動時に案内が出る (進めると herdr がこの行を書き戻す)
onboarding = false

[keys]
# tmux と同じ prefix。C-t を2回押すとアプリに C-t が届く (tmux の send-keys C-t と同じ)
prefix = "ctrl+t"

# tmux と同じく prefix+v でコピーモード (herdr の既定は prefix+[)
copy_mode = "prefix+v"
# 手動で右に分割する。既定の prefix+v はコピーモードに譲る。下への手動分割は既定の prefix+minus のまま
split_vertical = "prefix+shift+v"

# 最大化の切り替え (tmux で設定した M-m と、tilit の M-z)
zoom = ["prefix+z", "alt+m", "alt+z"]

# ペイン移動 (tilit の M-hjkl と、tmux で設定した M-矢印)。
# macOS の Ghostty は Option+←/→ を ESC b / ESC f に変えて送るので、Mac では alt+left/right は届かない
focus_pane_left = ["prefix+h", "alt+h", "alt+left"]
focus_pane_down = ["prefix+j", "alt+j", "alt+down"]
focus_pane_up = ["prefix+k", "alt+k", "alt+up"]
focus_pane_right = ["prefix+l", "alt+l", "alt+right"]

# ペインの入れ替え (tilit の M-H/J/K/L)。prefix+shift+h などは herdr の既定と同じ。
# キー名は配列の文字で判定するので、Colemak でも H/J/K/L の刻印のキーで動く
# 矢印では Ctrl+Alt+矢印 (Alt+矢印は移動、Alt+Shift+矢印は大きさ)。Linux の Ghostty は既定でこのキーを自分の分割の移動に使うので、ghostty/config.tmpl で外している
swap_pane_left = ["prefix+shift+h", "alt+shift+h", "ctrl+alt+left"]
swap_pane_down = ["prefix+shift+j", "alt+shift+j", "ctrl+alt+down"]
swap_pane_up = ["prefix+shift+k", "alt+shift+k", "ctrl+alt+up"]
swap_pane_right = ["prefix+shift+l", "alt+shift+l", "ctrl+alt+right"]

# ペインの大きさ (tmux と同じ Alt+Shift+矢印。移動の Alt+矢印とぶつからない)
resize_pane_left = "alt+shift+left"
resize_pane_down = "alt+shift+down"
resize_pane_up = "alt+shift+up"
resize_pane_right = "alt+shift+right"

# 数字キーの切り替え。tab は prefix+数字だけ。Alt+数字は N 番目のエージェント (サイドバーの表示順)、Ctrl+数字は N 番目の space (workspace)。
# 対象が無い番号では何も起きない。Ctrl+数字を区別して送るには端末が kitty keyboard protocol を話す必要がある (foot 1.28 / Ghostty は対応)。
# Linux の Ghostty は既定で Alt+1..9 を自分のタブ切り替えに使うので、ghostty/config.tmpl で外している
switch_tab = "prefix+1..9"
focus_agent = "alt+1..9"
# Mac の Cmd+数字は Ghostty の既定のタブ切り替えを外して使う (ghostty/config.tmpl)
{{- if eq .chezmoi.os "darwin" }}
switch_workspace = "cmd+1..9"
{{- else }}
switch_workspace = "ctrl+1..9"
{{- end }}

# tmux の Alt+f (fzf で window を選ぶ) を herdr の Go To に割り当てる。Go To はエージェントを状態で絞り込める。
# Mac では Option+→ も ESC f になるので Go To が開く (tmux で fzf が開くのと同じ)
goto = ["prefix+g", "alt+f"]

# tmux の after-split-window hook 相当の自動整列。Alt+Enter で枚数に応じて main-vertical / tiled に近い並びになるよう分割する。
# herdr に自動レイアウトが無いので、既存ペインは動かさず分割先と方向を選ぶ (~/.local/bin/herdr-auto-split)
[[keys.command]]
key = "alt+enter"
type = "shell"
command = '"$HOME/.local/bin/herdr-auto-split"'
description = "自動整列で分割する"

# tmux の M-Tab (switch-client -l) と同じく直前の workspace に戻る。
# herdr の previous_workspace は並び順で動くだけなので、履歴をプラグインで持つ (~/.local/share/herdr-plugins/last-workspace)
[[keys.command]]
key = "alt+tab"
type = "plugin_action"
command = "nagamine.last-workspace.toggle"
description = "直前の workspace に戻る"

# tilit の M-g と同じ。前面が Neovim のペインでは、その Neovim の中のフロートで lazygit を開閉する (:LazygitFloatToggle)。
# Neovim 以外 (sim を含む) と判定失敗のときは lazygit のポップアップをペインの cwd で開く。
# 分岐は ~/.local/bin/herdr-git-diff、ポップアップの定義は ~/.local/share/herdr-plugins/git-diff。
# type = "popup" だと分岐の前に必ずポップアップが開いてしまうので shell にしている
[[keys.command]]
key = "alt+g"
type = "shell"
command = '"$HOME/.local/bin/herdr-git-diff"'
description = "lazygit を開く (Neovim では中のフロートで開閉)"

# ツリーを開いた Neovim。中では C-p (検索) と Space gg (diffview) も使える
[[keys.command]]
key = "prefix+f"
type = "popup"
command = "nvim +Neotree"
width = "90%"
height = "90%"
description = "ツリーを開いた Neovim を開く"

# 移していないもの:
# - M-[ / M-] と S-←/→ (前後の window): Alt+[ は制御シーケンスの頭と同じバイトで、Shift+矢印はエディタの入力で使う
# - M-x / M-X / M-q / M-D / M-w (閉じる・切り離す): 1打で壊れる操作は直接キーにしない
# - 自動レイアウトとの差分: ペインを閉じたときの再整列はしない。prefix M-Enter のトグルは移していない。手動分割は prefix+shift+v / prefix+minus

[ui]
# ズーム中 (alt+m / alt+z / prefix+z) はタブの行の右端に ZOOM を出す。
# タブが 1 つでも表示が見えるよう、タブの行は常に出す (隠すと ZOOM も一緒に消える)
tab_bar_right = [{ type = "zoom" }]
hide_tab_bar_when_single_tab = false
# エージェントの一覧を space ごとではなく、注意が必要な順に並べる
agent_panel_sort = "priority"

# エージェントの完了と承認待ちは herdr がデスクトップに通知する。通知元のタブを表示中で、端末にフォーカスがある (または分からない) ときは出さない。
# Claude Code のフックの claude-notify は、herdr の中ではデスクトップに出さず、スマホ (ntfy) への送信と移動先の記録だけをする。
# どちらの配信でも、通知をクリックしてもペインへは移らない (herdr 0.9.5 でクリックでペインへ移るのは Windows だけ)。
# Linux は system (notify-send を swaync が表示する)。移るときは Super+Shift+R (claude-notify-focus --last)。
# Mac は terminal (OSC 9 で Ghostty が表示する)。system は terminal-notifier が無いと osascript になり、クリックしても端末に戻れない
[ui.toast]
{{- if eq .chezmoi.os "darwin" }}
delivery = "terminal"
{{- else }}
delivery = "system"
{{- end }}

# サイドバーのエージェント行。1 行目は「状態の点とワークスペース名」(例: ● chezmoi)。
# タブ名は出さない。作業内容は 2 行目の agent (Haiku の要約) が示す。
# 優先度の記号は置かない。state_icon の色で足りる。
[ui.sidebar.agents]
rows = [
  ["state_icon", "machine", "workspace"],
  ["agent"],
]

# Claude の行は、既定の 2 行の下に、実行中のサブエージェントを出す (例: ⧗2 coder, Explore)。
# 値は ~/.claude/hooks/herdr-subagents.sh がペインの metadata (subagents) に報告する。rows_by_agent は rows を置き換えるので 1 行目も書く
[ui.sidebar.agents.rows_by_agent]
claude = [
  ["state_icon", "machine", "workspace"],
  ["agent"],
  ["$subagents"],
]
