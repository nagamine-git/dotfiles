{{- $c := .theme.colors -}}
{{- if eq .chezmoi.hostname "fp7-e14" -}}{{- $c = .theme.colors_catppuccin -}}{{- end -}}
{{- $f := .theme.fonts -}}
general {
    # キーボード入力の問題を修正
    hide_cursor = false
    grace = 0
    ignore_empty_input = false
    immediate_render = true
    text_trim = true
    fractional_scaling = 2
    fail_timeout = 2000
}

auth {
    # PAM認証の改善
    pam:enabled = true
    pam:module = hyprlock
}

# アニメーションを無効化してフォーカス問題を回避
animations {
    enabled = false
}

background {
    monitor =
    path = screenshot
    blur_size = 8
    # blur_passes は 3 から 1 に下げた (2026-08-08)。4K スクリーンショットへの
    # 3 パスブラーで hyprlock が GPU に不正なコマンドを吐き、amdgpu が
    # "Illegal opcode in command stream" + CPF page fault を報告して落ちていた。
    # 08-06 21:20 は同じ経路で ring reset に失敗し Hyprland ごと道連れになった。
    # 再発が止まらなければ 0 (blur 無効) か path=screenshot の廃止まで下げる。
    blur_passes = 1
    # 背景のスクリーンショットを暗くする (2026-11)。白いページを開いたままロックすると、
    # 時計の文字と背景の差が 1.1–1.8:1 しかなかった。0.25 で背景が白でも本文 5:1 前後になる。
    # brightness はぼかしのシェーダーの中で掛かるので、blur_passes を増やさずに済む
    brightness = 0.25
}

input-field {
    monitor =
    size = 300, 50
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.15
    outer_color = rgba({{ $c.text.rgb }}, 0.45)
    inner_color = rgba({{ $c.bg_medium.rgb }}, 0.92)
    font_color = rgba({{ $c.text.rgb }}, 1.0)
    font_family = {{ $f.ui }}
    fade_on_empty = false
    fade_timeout = 0
    hide_input = false
    rounding = {{ .theme.shape.radius_md }}
    check_color = rgba({{ $c.accent.rgb }}, 1.0)
    fail_color = rgba({{ $c.error.rgb }}, 1.0)
    capslock_color = rgba({{ $c.warning.rgb }}, 1.0)
    placeholder_text = <span foreground="##{{ $c.text.hex }}aa">パスワードを入力</span>
    # デバッグ用：失敗時の詳細表示
    fail_text = <i>認証失敗 <b>($ATTEMPTS)</b> - $FAIL</i>

    position = 0, -20
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "<span>$(date "+%H:%M:%S")</span>"
    color = rgba({{ $c.text.rgb }}, 1.0)
    # 離れた位置からも読めるよう 28 から倍にした
    font_size = 56
    font_family = {{ $f.ui }}
    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:30000] echo "<span>$(date "+%Y年%m月%d日 (%a)")</span>"
    color = rgba({{ $c.text_dim.rgb }}, 1.0)
    font_size = 16
    font_family = {{ $f.ui }}
    position = 0, 50
    halign = center
    valign = center
}
