{{- $c := .theme.colors -}}
{{- if eq .chezmoi.hostname "fp7-e14" -}}{{- $c = .theme.colors_catppuccin -}}{{- end -}}
{{- $f := .theme.fonts -}}
general {
    # キーボード入力の問題を修正
    hide_cursor = false
    grace = 0
    ignore_empty_input = false
    immediate_render = true
    text_trim = true
    fractional_scaling = 2
    fail_timeout = 2000
}

auth {
    # PAM認証の改善
    pam:enabled = true
    pam:module = hyprlock
}

# アニメーションを無効化してフォーカス問題を回避
animations {
    enabled = false
}

background {
    monitor =
    # 今の壁紙をぼかした画像 (wallpaper-lock-image が darkman の壁紙の切替のたびに作る)。
    # 2026-11 までは path = screenshot を hyprlock でぼかしていたが、真っ暗に近くするしか読みやすさを保てなかった。
    # GPU でのぼかしは使わない (blur_passes = 0)。4K のスクリーンショットへの 3 パスのぼかしで
    # hyprlock が GPU に不正なコマンドを出し、amdgpu が "Illegal opcode in command stream" で落ちたことがある (2026-08)
    path = {{ .chezmoi.homeDir }}/.local/share/wallpaper/wallpaper-lock.jpg
    # 画像が無いときの色
    color = rgba({{ $c.bg_dark.rgb }}, 1.0)
    blur_passes = 0
}

# 時計・日付・入力欄の後ろに敷く暗い板。背景は明るい壁紙のこともあるので、文字の読みやすさはこの板で保つ
# (板の不透明度 0.75 なら、背後が昼の明るい壁紙でも本文と板の差は 5:1 以上)
shape {
    monitor =
    size = 440, 280
    color = rgba({{ $c.bg_dark.rgb }}, 0.75)
    rounding = {{ .theme.shape.radius_lg }}
    border_size = 1
    border_color = rgba({{ $c.bg_light.rgb }}, 1.0)
    position = 0, 55
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 50
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.15
    outer_color = rgba({{ $c.text.rgb }}, 0.45)
    inner_color = rgba({{ $c.bg_medium.rgb }}, 0.92)
    font_color = rgba({{ $c.text.rgb }}, 1.0)
    font_family = {{ $f.ui }}
    fade_on_empty = false
    fade_timeout = 0
    hide_input = false
    rounding = {{ .theme.shape.radius_md }}
    check_color = rgba({{ $c.accent.rgb }}, 1.0)
    fail_color = rgba({{ $c.error.rgb }}, 1.0)
    capslock_color = rgba({{ $c.warning.rgb }}, 1.0)
    placeholder_text = <span foreground="##{{ $c.text.hex }}aa">パスワードを入力</span>
    # デバッグ用：失敗時の詳細表示
    fail_text = <i>認証失敗 <b>($ATTEMPTS)</b> - $FAIL</i>

    position = 0, -20
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "<span>$(date "+%H:%M:%S")</span>"
    color = rgba({{ $c.text.rgb }}, 1.0)
    # 離れた位置からも読めるよう 28 から倍にした
    font_size = 56
    font_family = {{ $f.ui }}
    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:30000] echo "<span>$(date "+%Y年%m月%d日 (%a)")</span>"
    color = rgba({{ $c.text_dim.rgb }}, 1.0)
    font_size = 16
    font_family = {{ $f.ui }}
    position = 0, 50
    halign = center
    valign = center
}
