{{- $c := .theme.colors_elevation -}}
{{- if eq .chezmoi.hostname "fp7-e14" -}}{{- $c = .theme.colors_catppuccin -}}{{- end -}}
{{- $f := .theme.fonts -}}
general {
    # キーボード入力の問題を修正
    hide_cursor = false
    grace = 0
    ignore_empty_input = false
    immediate_render = true
    text_trim = true
    fractional_scaling = 2
    fail_timeout = 2000
}

auth {
    # PAM認証の改善
    pam:enabled = true
    pam:module = hyprlock
}

# アニメーションを無効化してフォーカス問題を回避
animations {
    enabled = false
}

background {
    monitor =
    # 今の壁紙をぼかした画像 (wallpaper-lock-image が darkman の壁紙の切替のたびに作る)。
    # 2026-11 までは path = screenshot を hyprlock でぼかしていたが、真っ暗に近くするしか読みやすさを保てなかった。
    # GPU でのぼかしは使わない (blur_passes = 0)。4K のスクリーンショットへの 3 パスのぼかしで
    # hyprlock が GPU に不正なコマンドを出し、amdgpu が "Illegal opcode in command stream" で落ちたことがある (2026-08)
    path = {{ .chezmoi.homeDir }}/.local/share/wallpaper/wallpaper-lock.jpg
    # 画像が無いときの色
    color = rgba({{ $c.bg_dark.rgb }}, 1.0)
    blur_passes = 0
}

# 時計・日付・入力欄を載せるカード (2026-11 に調整)。背景は明るい壁紙のこともあるので、文字の読みやすさはこの板で保つ
# (不透明度 0.75 なら、背後が昼の明るい壁紙でも本文と板の差は 5:1 以上)。
# 縦の配置は 32px の余白でそろえる: カードの上端 → 時計 (32) / 時計 → 日付 (12) / 日付 → 入力欄 (32) / 入力欄 → 下端 (32)。
# position は画面の中心からの距離 (上が正)。カード 400x252 の中心を 54 に置くと、上端 180・下端 -72 になる
shape {
    monitor =
    size = 400, 252
    color = rgba({{ $c.bg_dark.rgb }}, 0.75)
    rounding = {{ .theme.shape.radius_lg }}
    # 枠線は付けない (案 B: 面の明るさで浮かせる)
    border_size = 0
    position = 0, 54
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 48
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgba({{ $c.surface.rgb }}, 1.0)
    inner_color = rgba({{ $c.bg_medium.rgb }}, 1.0)
    font_color = rgba({{ $c.text.rgb }}, 1.0)
    font_family = {{ $f.ui }}
    fade_on_empty = false
    fade_timeout = 0
    hide_input = false
    rounding = {{ .theme.shape.radius_md }}
    check_color = rgba({{ $c.accent.rgb }}, 1.0)
    fail_color = rgba({{ $c.error.rgb }}, 1.0)
    capslock_color = rgba({{ $c.warning.rgb }}, 1.0)
    placeholder_text = <span foreground="##{{ $c.text_dim.hex }}">パスワードを入力</span>
    fail_text = <span foreground="##{{ $c.error_text.hex }}">認証失敗 ($ATTEMPTS) - $FAIL</span>
    position = 0, -16
    halign = center
    valign = center
}

# 時計は「時:分」だけを大きく細い字で出す (秒は毎秒動いて目を引くうえ、ロック中は要らない)
label {
    monitor =
    text = cmd[update:1000] echo "<span>$(date "+%H:%M")</span>"
    color = rgba({{ $c.text.rgb }}, 1.0)
    font_size = 64
    font_family = {{ $f.ui }} Light
    position = 0, 108
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:30000] echo "<span>$(date "+%-m月%-d日 %A")</span>"
    color = rgba({{ $c.text_dim.rgb }}, 1.0)
    font_size = 15
    font_family = {{ $f.ui }}
    position = 0, 48
    halign = center
    valign = center
}
