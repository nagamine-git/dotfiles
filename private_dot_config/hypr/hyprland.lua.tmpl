hl.bind(mainMod .. " + SHIFT + f", hl.dsp.window.fullscreen())
-- Alt+M: 前面が端末ならキーをそのまま端末へ渡す (中の herdr が zoom する)。それ以外のアプリでは maximize トグル。
-- pass_event は押下と離しの両方を修飾キーごと届ける。Ghostty のクラスは既定の com.mitchellh.ghostty
local passAltMClasses = { ["foot"] = true, ["footclient"] = true, ["com.mitchellh.ghostty"] = true }
hl.bind("ALT + m", function()
    local window = hl.get_active_window()
    if window and passAltMClasses[window.class] then
        return { pass_event = true }
    end
    return hl.dispatch(hl.dsp.window.fullscreen({ mode = "maximized" }))
end)
