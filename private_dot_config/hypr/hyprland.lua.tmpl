hl.bind(mainMod .. " + SHIFT + down", hl.dsp.window.move({ direction = "down" }))
hl.bind(mainMod .. " + SHIFT + up", hl.dsp.window.move({ direction = "up" }))
hl.bind(mainMod .. " + SHIFT + right", hl.dsp.window.move({ direction = "right" }))

-- === WORKSPACES ===
hl.bind(mainMod .. " + 1", hl.dsp.focus({ workspace = 1 }))
hl.bind(mainMod .. " + 2", hl.dsp.focus({ workspace = 2 }))
hl.bind(mainMod .. " + 3", hl.dsp.focus({ workspace = 3 }))
hl.bind(mainMod .. " + 4", hl.dsp.focus({ workspace = 4 }))
hl.bind(mainMod .. " + 5", hl.dsp.focus({ workspace = 5 }))
hl.bind(mainMod .. " + 6", hl.dsp.focus({ workspace = 6 }))
hl.bind(mainMod .. " + 7", hl.dsp.focus({ workspace = 7 }))
hl.bind(mainMod .. " + 8", hl.dsp.focus({ workspace = 8 }))
hl.bind(mainMod .. " + 9", hl.dsp.focus({ workspace = 9 }))
hl.bind(mainMod .. " + 0", hl.dsp.focus({ workspace = 10 }))

-- === MOVE TO WORKSPACES ===
hl.bind(mainMod .. " + SHIFT + 1", hl.dsp.window.move({ workspace = 1 }))
hl.bind(mainMod .. " + SHIFT + 2", hl.dsp.window.move({ workspace = 2 }))
hl.bind(mainMod .. " + SHIFT + 3", hl.dsp.window.move({ workspace = 3 }))
hl.bind(mainMod .. " + SHIFT + 4", hl.dsp.window.move({ workspace = 4 }))
hl.bind(mainMod .. " + SHIFT + 5", hl.dsp.window.move({ workspace = 5 }))
hl.bind(mainMod .. " + SHIFT + 6", hl.dsp.window.move({ workspace = 6 }))
hl.bind(mainMod .. " + SHIFT + 7", hl.dsp.window.move({ workspace = 7 }))
hl.bind(mainMod .. " + SHIFT + 8", hl.dsp.window.move({ workspace = 8 }))
hl.bind(mainMod .. " + SHIFT + 9", hl.dsp.window.move({ workspace = 9 }))
hl.bind(mainMod .. " + SHIFT + 0", hl.dsp.window.move({ workspace = 10 }))

-- === SCRATCHPAD ===
hl.bind(mainMod .. " + grave", hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + SHIFT + grave", hl.dsp.window.move({ workspace = "special:magic" }))
hl.bind(mainMod .. " + SHIFT + minus", hl.dsp.workspace.toggle_special("desktop"))

-- === MOUSE OPERATIONS ===
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- === MULTIMEDIA KEYS (swayosd-client で OSD 付き) ===
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("swayosd-client --output-volume raise"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("swayosd-client --output-volume lower"), { locked = true, repeating = true })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("swayosd-client --output-volume mute-toggle"), { locked = true, repeating = true })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("swayosd-client --input-volume mute-toggle"), { locked = true, repeating = true })
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("swayosd-client --brightness raise"), { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("swayosd-client --brightness lower"), { locked = true, repeating = true })

-- === MEDIA CONTROLS ===
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"), { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"), { locked = true })

-- === LAPTOP LID ===
hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd([[hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })']]), { locked = true })
-- hl.monitor は同じ output の既存ルールへマージするので、再有効化には disabled = false が要る。
{{- if eq .chezmoi.hostname "fp7-e14" }}
-- 蓋開け: 内蔵パネルの scale は monitors.lua と一致させ 1.25。
-- 素早い開閉のチャタリングや amdgpu PSR スタックでパネルが黒落ちするため、再有効化後に dpms on を明示する
-- (fp7-e14 は hypridle 不使用で DPMS 復帰の保険が無いため必須)。
-- さらに suspend 復帰と重なると hl.monitor での再有効化が取りこぼされ eDP-1 が disable のまま残る事故が
-- あるため、monitors.lua を読み直す reload を保険として最後に撃ち、確実に内蔵パネルを復活させる。
hl.bind("switch:off:Lid Switch", hl.dsp.exec_cmd([[hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1.25, disabled = false })' && hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' && hyprctl reload]]), { locked = true })
{{- else }}
hl.bind("switch:off:Lid Switch", hl.dsp.exec_cmd([[hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1, disabled = false })' && hyprctl dispatch 'hl.dsp.dpms({ action = "on" })']]), { locked = true })
{{- end }}

-- === CLIPBOARD MANAGEMENT ===
hl.bind("CTRL + " .. mainMod .. " + V", hl.dsp.exec_cmd([[cliphist list | rofi -dmenu -p "📋 選択→貼り付け" | cliphist decode | wl-copy && sleep 0.1 && wtype -M ctrl v]]))

-- === NOTIFICATION CENTER ===
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd("swaync-client -t -sw"))
-- 最後に完了・承認待ちになった Claude Code の herdr のペインへ移る (herdr の通知はクリックしてもペインへ移らない)
hl.bind(mainMod .. " + SHIFT + R", hl.dsp.exec_cmd("~/.local/bin/claude-notify-focus --last"))

-- === SCREENSHOTS (satty) ===
-- grim は ppm (無圧縮) で渡して PNG エンコードを省く。保存先・コピー・early-exit は ~/.config/satty/config.toml。
-- satty は保存先ディレクトリを作らないため、撮影のたびに mkdir -p する。
local shotdir = "~/Pictures/Screenshots"

-- === SCREENSHOTS (WINDOWS/LINUX STYLE) ===
hl.bind("Print", hl.dsp.exec_cmd("mkdir -p " .. shotdir .. "; grim -t ppm - | satty --filename -"))
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("mkdir -p " .. shotdir .. [[; grim -g "$(slurp)" -t ppm - | satty --filename -]]))

-- === SCREENSHOTS (CORRECTED) ===
hl.bind(mainMod .. " + SHIFT + P", hl.dsp.exec_cmd("mkdir -p " .. shotdir .. "; grim -t ppm - | satty --filename -"))
hl.bind(mainMod .. " + CTRL + SHIFT + P", hl.dsp.exec_cmd("mkdir -p " .. shotdir .. [[; grim -g "$(slurp)" -t ppm - | satty --filename -]]))

-- === RENDERING OPTIMIZATION ===
hl.config({
    render = {
        direct_scanout = false,
    },
})
