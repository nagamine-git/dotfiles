-- rofi (waybar の Exit Node の選択と Ctrl+Super+V のクリップボード履歴) も blur。
-- 半透明のまま背後をぼかすことで、後ろに端末など
-- 文字の多いウィンドウがあっても行のテキストが読める (blur 無しだと素通しで
-- 実効コントラストが背後次第になり、テーマ側で測った 8.66:1 が保証されない)
hl.layer_rule({ match = { namespace = "rofi" }, blur = true })
hl.layer_rule({ match = { namespace = "rofi" }, ignore_alpha = 0.5 })

-- ランチャー (Vicinae) は blur して、開閉のアニメーションを付けない (公式の Hyprland 向けの設定)
hl.layer_rule({ match = { namespace = "vicinae" }, blur = true, ignore_alpha = 0 })
hl.layer_rule({ match = { namespace = "vicinae" }, no_anim = true })

