{{- $c := .theme.colors_elevation -}}
{{- if eq .chezmoi.hostname "fp7-e14" -}}{{- $c = .theme.colors_catppuccin -}}{{- end -}}
{{- $f := .theme.fonts -}}
/*
 * rofi theme — rofi -dmenu の選択画面 (waybar の Exit Node、Ctrl+Super+V のクリップボード履歴)。
 * ランチャー (Super+Space) は Vicinae に移した
 *
 * 設計の根拠 (2026-11 に配色を案 B「エレベーション」= colors_elevation へ):
 *  - 文字サイズは 1.25 の等比スケール: 本文 13 / 入力欄 16 (入力欄を焦点にする)
 *  - 不透明な面の明るさで高さを示し、外枠は付けない: 窓 = 高さ 2、入力欄 = 高さ 1 (一段沈める)、選択行 = 高さ 3
 *  - am5-itx の配色では、本文は選択行の上でも 10.6:1、補助テキスト (text_dim) は 5.1:1
 *  - 選択状態は「背景 + 文字色 + 左アクセントバー」の3チャネルで冗長に示す
 *  - 不透明なので、背後のウィンドウや壁紙に読みやすさが左右されない
 *
 * 寸法についての注意 (スクリーンショットからの実測ベース):
 *  rofi のフォント指定は pt で、モニタスケール (この環境では 1.5) が乗る。
 *  一方 px 指定にはスケールが乗らないので、両者を混ぜるとアイコンだけ相対的に
 *  小さくなる (20px 指定では行の文字に対して明らかに小さかった)。そこで
 *  アイコンは em 指定にして文字に追従させる。em は行の高さ基準で解決されるため
 *  1.0em でアイコン高さ = 文字の行高となり、両者の釣り合いが取れる。
 *  実測値: アイコン 26 論理px / 行ピッチ 57.3 論理px / 12 行で高さ 775 論理px。
 */
configuration {
    show-icons: true;
    icon-theme: "Adwaita";

    matching: "fuzzy";
    case-sensitive: false;
    /* 一致度順に並べ替える。無効だと元の並び順のままなので、"zeed" と打っても
       完全一致の Zeed が下の方に埋もれる */
    sort: true;
    sorting-method: "fzf";

    cycle: true;
    sidebar-mode: false;
    hover-select: true;

    /* 行番号ジャンプ (vim flash 的な直接移動)。番号は element-index が各行に
       表示し、絞り込みに追従して振り直される。
       既定の Super+N は Hyprland のワークスペース切替に奪われるので Alt+N に。
       Alt+N は kb-custom-N が先に押さえているため、空文字で解放してから割り当てる */
    kb-custom-1: "";
    kb-custom-2: "";
    kb-custom-3: "";
    kb-custom-4: "";
    kb-custom-5: "";
    kb-custom-6: "";
    kb-custom-7: "";
    kb-custom-8: "";
    kb-custom-9: "";
    kb-custom-10: "";
    kb-select-1: "Alt+1";
    kb-select-2: "Alt+2";
    kb-select-3: "Alt+3";
    kb-select-4: "Alt+4";
    kb-select-5: "Alt+5";
    kb-select-6: "Alt+6";
    kb-select-7: "Alt+7";
    kb-select-8: "Alt+8";
    kb-select-9: "Alt+9";
    kb-select-10: "Alt+0";
}

* {
    font: "{{ $f.ui }} 13";

    bg-window: #{{ $c.bg_light.hex }};
    bg-input: #{{ $c.bg_medium.hex }};
    bg-selected: #{{ $c.surface.hex }};
    border-col: transparent;

    fg: #{{ $c.text.hex }};
    fg-accent: #{{ $c.accent.hex }};
    fg-dim: #{{ $c.text_dim.hex }};
    /* 行番号バッジ用の飾り。文字ではないので非テキスト UI の 3:1 を基準にする */
    fg-faint: #{{ (default $c.text_dim (index $c "text_faint")).hex }};

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 800px;
    location: center;
    padding: 8px;
    border-radius: {{ .theme.shape.radius_lg }}px;
    background-color: @bg-window;
    border: 0px;
}

/* message を listview の後ろに置いて Raycast 的なフッターにする
   (既定では inputbar と listview の間に入る) */
mainbox {
    padding: 0px;
    spacing: 0px;
    background-color: transparent;
    children: [ "inputbar", "listview", "message" ];
}

/* prompt を children から外すことでモード名や -p の文字を表示しない。
   案内は entry の placeholder のみに任せる */
inputbar {
    margin: 0px 0px 8px 0px;
    padding: 12px 16px;
    border-radius: {{ .theme.shape.radius_md }}px;
    background-color: @bg-input;
    children: [ "entry" ];
}

entry {
    font: "{{ $f.ui }} 16";
    text-color: @fg;
    placeholder: "検索…";
    placeholder-color: @fg-dim;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    padding: 0px;
    margin: 0px;
    spacing: 2px;
    border: 0px;
    lines: 12;
    fixed-height: false;
    scrollbar: false;
    dynamic: true;
}

/* 全要素に透明な 2px 左ボーダーを持たせ、選択時のみ着色する。
   こうしないと選択のたびに内容が 2px 横にずれてちらつく。
   element-index は行番号ジャンプ (Alt+N) の番号バッジ。右端に置く */
element {
    padding: 10px 14px;
    spacing: 12px;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: {{ .theme.shape.radius_md }}px;
    cursor: pointer;
    children: [ "element-icon", "element-text", "element-index" ];
}

/* em 指定 (px ではない): 上のコメント参照。文字とアイコンの比率を保つため */
element-icon {
    size: 1.0em;
    cursor: inherit;
    background-color: transparent;
}

element-text {
    expand: true;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    /* 一致部分の強調。既定の下線付きボールドは煩いのでアクセント色のボールドに。
       highlight は変数参照 (@name) を受け付けないため色をリテラルで書く */
    highlight: bold #{{ $c.accent.hex }};
}

/* 行番号バッジ。11 行目以降は空文字になるので幅を固定して列を揃える */
element-index {
    expand: false;
    width: 1.4em;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: @fg-faint;
    background-color: transparent;
    cursor: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

/* 選択行: 文字色は本文のままにして、背景と左バーで示す。
   行全体をアクセント色にすると主張が強すぎるため */
element selected.normal {
    background-color: @bg-selected;
    border-color: @fg-accent;
    text-color: @fg;
}

element urgent.normal,
element alternate.urgent {
    background-color: transparent;
    text-color: #{{ $c.warning.hex }};
}

element selected.urgent {
    background-color: @bg-selected;
    border-color: #{{ $c.warning.hex }};
    text-color: #{{ $c.warning.hex }};
}

element active.normal,
element alternate.active {
    background-color: transparent;
    text-color: @fg-accent;
}

element selected.active {
    background-color: @bg-selected;
    border-color: @fg-accent;
    text-color: @fg-accent;
}

/* フッター。区切りは罫線ではなく上向きの余白とごく淡い文字で示す */
message {
    margin: 6px 0px 0px 0px;
    padding: 8px 14px 2px 14px;
    border: 1px 0px 0px 0px;
    border-color: @border-col;
    background-color: transparent;
}

textbox {
    text-color: @fg-faint;
    vertical-align: 0.5;
}

error-message {
    padding: 16px;
    border-radius: {{ .theme.shape.radius_lg }}px;
    background-color: @bg-window;
    text-color: @fg;
}
